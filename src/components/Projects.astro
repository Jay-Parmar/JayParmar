---
import { projects, type Project } from '../data/projects';
import { splitFact } from '../lib/facts';
import { link } from '../lib/url';

const featured = projects.filter((project) => project.featured);
const cards = projects.filter((project) => !project.featured && (project.page || project.code));
const also = projects.filter((project) => !project.featured && !project.page && !project.code);
const meta = (project: Project) => [project.year, project.where].filter(Boolean).join(', ');
const morph = (project: Project) => (project.page ? `view-transition-name: project-${project.slug}` : undefined);
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <h2 class="title" id="projects-title">Projects</h2>
    <p class="lead">Newest first. The first three are open source.</p>

    {
      featured.map((project) => (
        <article class="featured panel" id={`project-${project.slug}`}>
          <div class="head">
            <p class="meta">
              <span>{meta(project)}</span>
              {project.code && <span class="open">Open source</span>}
            </p>
            <h3 style={morph(project)}>{project.name}</h3>
            <p class="tagline">{project.tagline}</p>
          </div>
          <ul class="stats" role="list">
            {project.facts.map((fact) => {
              const [num, label] = splitFact(fact);
              return (
                <li>
                  {num && <span class="num">{num}</span>} <span class="label">{label}</span>
                </li>
              );
            })}
          </ul>
          <ul class="stack" role="list" aria-label="Built with">
            {project.stack.map((tool) => (
              <li class="chip">{tool}</li>
            ))}
          </ul>
          <p class="actions">
            {project.page && (
              <a class="button primary" href={link(`projects/${project.slug}/`)} aria-label={`${project.name}, how it works`}>
                How it works
              </a>
            )}
            {project.code && (
              <a class="button" href={project.code} aria-label={`${project.name} code on GitHub`}>
                Code on GitHub
              </a>
            )}
          </p>
        </article>
      ))
    }

    <div class="grid">
      {
        cards.map((project) => (
          <article class="card panel" id={`project-${project.slug}`}>
            <p class="meta">
              <span>{meta(project)}</span>
              {project.code && <span class="open">Open source</span>}
            </p>
            <h3 style={morph(project)}>{project.name}</h3>
            <p class="tagline">{project.tagline}</p>
            {project.facts.length > 0 && (
              <ul class="facts" role="list">
                {project.facts.map((fact) => {
                  const [num, label] = splitFact(fact);
                  return (
                    <li>
                      {num && <span class="num">{num}</span>} {label}
                    </li>
                  );
                })}
              </ul>
            )}
            <ul class="stack" role="list" aria-label="Built with">
              {project.stack.map((tool) => (
                <li class="chip">{tool}</li>
              ))}
            </ul>
            {(project.page || project.code) && (
              <p class="links">
                {project.page && (
                  <a href={link(`projects/${project.slug}/`)} aria-label={`${project.name}, how it works`}>
                    How it works
                  </a>
                )}
                {project.code && (
                  <a href={project.code} aria-label={`${project.name} code on GitHub`}>
                    Code on GitHub
                  </a>
                )}
              </p>
            )}
          </article>
        ))
      }
    </div>

    {
      also.length > 0 && (
        <div class="also panel">
          <h3 class="also-title" id="also-title">
            Also built
          </h3>
          {also.map((project) => (
            <article class="row" id={`project-${project.slug}`}>
              <div>
                <h4>{project.name}</h4>
                <p class="meta">{meta(project)}</p>
              </div>
              <div>
                <p class="tagline">{project.tagline}</p>
                {project.facts.length > 0 && (
                  <ul class="facts" role="list">
                    {project.facts.map((fact) => {
                      const [num, label] = splitFact(fact);
                      return (
                        <li>
                          {num && <span class="num">{num}</span>} {label}
                        </li>
                      );
                    })}
                  </ul>
                )}
                <ul class="stack" role="list" aria-label="Built with">
                  {project.stack.map((tool) => (
                    <li class="chip">{tool}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  if (matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('#projects .card')) {
      let last: PointerEvent | null = null;

      const paint = () => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--x', `${last!.clientX - box.left}px`);
        card.style.setProperty('--y', `${last!.clientY - box.top}px`);
        last = null;
      };

      card.addEventListener(
        'pointermove',
        (event) => {
          if (!last) requestAnimationFrame(paint);
          last = event;
        },
        { passive: true },
      );
    }
  }
</script>

<style>
  .featured {
    --pad: var(--inset);
    display: grid;
    grid-template-areas: 'head' 'stats' 'stack' 'actions';
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    overflow: hidden;
    background:
      radial-gradient(42rem 26rem at 0% 0%, rgb(110 161 255 / 0.07), transparent 70%),
      var(--surface);
  }

  .head {
    grid-area: head;
    padding: var(--pad) var(--pad) 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem 0.2rem 0.5rem;
    border: 1px solid var(--border-2);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--step--2);
    font-weight: 500;
    line-height: 1.3;
  }

  .open::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgb(110 161 255 / 0.16);
  }

  h3 {
    width: fit-content;
    margin-top: 0.75rem;
    font-size: var(--step-3);
    letter-spacing: -0.025em;
  }

  .featured h3 {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.75rem + 2.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .tagline {
    max-width: 52ch;
    margin-top: 0.6rem;
  }

  .featured .tagline {
    max-width: 40ch;
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .stats {
    grid-area: stats;
    margin: 2rem var(--pad) 0;
    border-top: 1px solid var(--border);
  }

  .stats li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .stats .num {
    flex: none;
    min-width: 3.4em;
    color: var(--text);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stats .label {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .stats .label:only-child {
    color: var(--text-2);
    font-size: var(--step-0);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .featured .stack {
    grid-area: stack;
    margin: 0;
    padding: 1.75rem var(--pad) 0;
  }

  .actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 2rem var(--pad) var(--pad);
  }

  @media (min-width: 56rem) {
    .featured {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 21rem);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'head stats'
        'stack stats'
        'actions stats';
    }

    .stats {
      display: grid;
      grid-auto-rows: 1fr;
      margin: 0;
      border-top: 0;
      border-left: 1px solid var(--border);
      background: var(--bg-raised);
    }

    .stats li {
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 1.5rem 2rem;
      border-bottom: 0;
    }

    .stats li + li {
      border-top: 1px solid var(--border);
    }

    .stats .num {
      min-width: 0;
      font-size: var(--step-4);
    }

    .actions {
      align-self: end;
    }
  }

  .grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    --pad: var(--inset);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding: var(--pad);
    transition: border-color 0.25s;
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--border-2);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(.js) .card::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background: radial-gradient(24rem circle at var(--x, 50%) var(--y, 50%), rgb(110 161 255 / 0.08), transparent 65%);
      opacity: 0;
      transition: opacity 0.35s;
      pointer-events: none;
    }

    :global(.js) .card:hover::before {
      opacity: 1;
    }
  }

  .facts {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: var(--step--1);
  }

  .facts li {
    position: relative;
    padding-left: 1.1rem;
  }

  .facts li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.68em;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--muted);
  }

  .facts .num {
    color: var(--text);
    font-weight: 600;
  }

  .card .stack {
    margin: 1.5rem 0 auto;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.5rem calc(-1 * var(--pad)) calc(-1 * var(--pad));
    padding: 1rem var(--pad);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .links a {
    text-decoration-color: var(--border-2);
  }

  .links a:hover {
    text-decoration-color: var(--accent);
  }

  .also {
    --pad: var(--inset);
    margin-top: 1rem;
    padding-inline: var(--pad);
  }

  .also-title {
    width: auto;
    margin-top: 0;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0;
  }

  .row {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: 1.6rem;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  h4 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  .row .meta {
    margin-top: 0.35rem;
  }

  .row .tagline {
    margin-top: 0;
  }

  .row .stack {
    margin-top: 1.1rem;
  }
</style>
