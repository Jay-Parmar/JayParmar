---
import { projectSections, projects, type Project } from '../data/projects';
import { splitFact } from '../lib/facts';
import { link } from '../lib/url';
import ProjectMeta from './ProjectMeta.astro';

const featured = projects.filter((project) => project.featured);
const cards = projects.filter((project) => !project.featured && (project.page || project.code));
const also = projects.filter((project) => !project.featured && !project.page && !project.code);
const morph = (project: Project) => (project.page ? `view-transition-name: project-${project.slug}` : undefined);
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <h2 class="title" id="projects-title">Projects</h2>

    {
      featured.map((project) => (
        <article class="featured panel" id={`project-${project.slug}`}>
          <div class:list={['overview', { 'with-workflow': project.page?.steps.length }]}>
            <div class="head">
              <ProjectMeta project={project} />
              <h3 style={morph(project)}>{project.name}</h3>
              <p class="tagline">{project.tagline}</p>
              <ul class="stack" role="list" aria-label="Built with">
                {project.stack.map((tool) => (
                  <li class="chip">{tool}</li>
                ))}
              </ul>
              <p class="actions">
                {project.page && (
                  <a class="button primary" href={link(`projects/${project.slug}/`)} aria-label={`${project.name}, how it works`}>
                    How it works
                  </a>
                )}
                {project.code && (
                  <a class="button" href={project.code} aria-label={`${project.name} code on GitHub`}>
                    Code on GitHub
                  </a>
                )}
              </p>
            </div>
            {project.page && project.page.steps.length > 0 && (
              <nav class="workflow" aria-labelledby={`workflow-${project.slug}`}>
                <h4 id={`workflow-${project.slug}`}>{projectSections.what}</h4>
                <ol role="list">
                  {project.page.steps.map((step) => (
                    <li>
                      <a href={link(`projects/${project.slug}/#step-${step.id}`)}>
                        <span>{step.name}</span>
                        {step.preview && <small>{step.preview}</small>}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </div>
          <ul class="stats" role="list">
            {project.facts.map((fact) => {
              const [num, label] = splitFact(fact);
              return (
                <li>
                  {num && <span class="num">{num}</span>} <span class="label">{label}</span>
                </li>
              );
            })}
          </ul>
        </article>
      ))
    }

    <div class="grid">
      {
        cards.map((project) => (
          <article class="card panel" id={`project-${project.slug}`}>
            <ProjectMeta project={project} />
            <h3 style={morph(project)}>{project.name}</h3>
            <p class="tagline">{project.tagline}</p>
            {project.facts.length > 0 && (
              <ul class="facts" role="list">
                {project.facts.map((fact) => {
                  const [num, label] = splitFact(fact);
                  return (
                    <li>
                      {num && <span class="num">{num}</span>} {label}
                    </li>
                  );
                })}
              </ul>
            )}
            <ul class="stack" role="list" aria-label="Built with">
              {project.stack.map((tool) => (
                <li class="chip">{tool}</li>
              ))}
            </ul>
            {(project.page || project.code) && (
              <p class="links">
                {project.page && (
                  <a href={link(`projects/${project.slug}/`)} aria-label={`${project.name}, how it works`}>
                    How it works
                  </a>
                )}
                {project.code && (
                  <a href={project.code} aria-label={`${project.name} code on GitHub`}>
                    Code on GitHub
                  </a>
                )}
              </p>
            )}
          </article>
        ))
      }
    </div>

    {
      also.length > 0 && (
        <div class="also panel">
          <h3 class="also-title" id="also-title">
            Also built
          </h3>
          {also.map((project) => (
            <article class="row" id={`project-${project.slug}`}>
              <div>
                <h4>{project.name}</h4>
                <ProjectMeta project={project} />
              </div>
              <div>
                <p class="tagline">{project.tagline}</p>
                {project.facts.length > 0 && (
                  <ul class="facts" role="list">
                    {project.facts.map((fact) => {
                      const [num, label] = splitFact(fact);
                      return (
                        <li>
                          {num && <span class="num">{num}</span>} {label}
                        </li>
                      );
                    })}
                  </ul>
                )}
                <ul class="stack" role="list" aria-label="Built with">
                  {project.stack.map((tool) => (
                    <li class="chip">{tool}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  if (matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('#projects .card')) {
      let last: PointerEvent | null = null;

      const paint = () => {
        const box = card.getBoundingClientRect();
        card.style.setProperty('--x', `${last!.clientX - box.left}px`);
        card.style.setProperty('--y', `${last!.clientY - box.top}px`);
        last = null;
      };

      card.addEventListener(
        'pointermove',
        (event) => {
          if (!last) requestAnimationFrame(paint);
          last = event;
        },
        { passive: true },
      );
    }
  }
</script>

<style>
  .featured {
    --pad: var(--inset);
    margin-top: 1.5rem;
    overflow: hidden;
    background:
      radial-gradient(42rem 26rem at 0% 0%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%),
      var(--surface);
  }

  .head {
    padding: var(--pad);
  }

  h3 {
    width: fit-content;
    margin-top: 0.75rem;
    font-size: var(--step-3);
    letter-spacing: -0.025em;
  }

  .featured h3 {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.75rem + 2.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .tagline {
    max-width: 52ch;
    margin-top: 0.6rem;
  }

  .featured .tagline {
    max-width: 40ch;
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .stats {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--border);
    background: var(--bg-raised);
  }

  .stats li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.85rem var(--pad);
  }

  .stats li + li { border-top: 1px solid var(--border); }

  .stats .num {
    flex: none;
    min-width: 3em;
    color: var(--text);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stats .label {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .stats .label:only-child {
    color: var(--text-2);
    font-size: var(--step-0);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .featured .stack {
    margin-top: 1.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .workflow {
    padding: var(--pad);
    border-top: 1px solid var(--border);
  }

  .workflow h4 {
    margin-bottom: 0.55rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .workflow ol { counter-reset: step; }
  .workflow li { counter-increment: step; }
  .workflow li + li { border-top: 1px solid var(--border); }
  .workflow a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.25rem;
    row-gap: 0.15rem;
    padding-block: 0.72rem;
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  .workflow a::before {
    content: counter(step, decimal-leading-zero);
    grid-row: 1 / span 2;
    align-self: start;
    padding-top: 0.2em;
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--step--2);
    font-weight: 400;
  }

  .workflow a::after {
    content: '';
    grid-column: 3;
    grid-row: 1 / span 2;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.2rem;
    border-top: 1.5px solid var(--muted);
    border-right: 1.5px solid var(--muted);
    transform: rotate(45deg);
  }

  .workflow span { grid-column: 2; transition: color 0.2s; }
  .workflow small { grid-column: 2; color: var(--muted); font-size: var(--step--1); font-weight: 400; }
  .workflow a:is(:hover, :focus-visible) span { color: var(--accent); }
  .workflow a:is(:hover, :focus-visible)::after { border-color: var(--accent); }

  @media (min-width: 48rem) {
    .with-workflow {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: center;
    }

    .workflow {
      margin-block: var(--pad);
      padding-block: 0;
      border-top: 0;
      border-left: 1px solid var(--border);
    }

    .stats { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
    .stats li { flex-wrap: wrap; }
    .stats li + li { border-top: 0; border-left: 1px solid var(--border); }
    .stats .num {
      min-width: 0;
      font-size: var(--step-3);
    }
  }

  .grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    --pad: var(--inset);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding: var(--pad);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card { transition: border-color 0.25s; }
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--border-2);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(.js) .card::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background: radial-gradient(24rem circle at var(--x, 50%) var(--y, 50%), color-mix(in srgb, var(--accent) 8%, transparent), transparent 65%);
      opacity: 0;
      transition: opacity 0.35s;
      pointer-events: none;
    }

    :global(.js) .card:hover::before {
      opacity: 1;
    }
  }

  .facts {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: var(--step--1);
  }

  .facts li {
    position: relative;
    padding-left: 1.1rem;
  }

  .facts li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.68em;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--muted);
  }

  .facts .num {
    color: var(--text);
    font-weight: 600;
  }

  .card .stack {
    margin: 1.5rem 0 auto;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.5rem calc(-1 * var(--pad)) calc(-1 * var(--pad));
    padding: 0.25rem var(--pad);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration-color: var(--border-2);
  }

  .links a:hover {
    text-decoration-color: var(--accent);
  }

  .also {
    --pad: var(--inset);
    margin-top: 1rem;
    padding-inline: var(--pad);
  }

  .also-title {
    width: auto;
    margin-top: 0;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0;
  }

  .row {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: 1.6rem;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  h4 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  .row :global(.meta) {
    margin-top: 0.35rem;
  }

  .row .tagline {
    margin-top: 0;
  }

  .row .stack {
    margin-top: 1.1rem;
  }
</style>
