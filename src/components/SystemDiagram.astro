---
const hosts = [
  { name: 'host-01', y: 68, load: 0.62, pace: '5.2s' },
  { name: 'host-02', y: 140, load: 0.44, pace: '6.4s' },
  { name: 'host-03', y: 212, load: 0.78, pace: '4.6s' },
];

// Cameras feed every host, and every host serves the live view.
const routes = hosts.map(({ y }) => {
  const mid = y + 28;
  return `M140 160C168 160 168 ${mid} 196 ${mid}H364C392 ${mid} 392 160 420 160`;
});

const packets = routes.flatMap((path, i) => [0, 1].map((k) => ({ path, begin: `${(1.4 + i * 0.55 + k * 1.6).toFixed(2)}s` })));
---

<figure class="system">
  <div class="window">
    <div class="bar">
      <p class="name">Multi-server video platform</p>
      <p class="stat">25 to <strong>240+</strong> cameras</p>
    </div>
    <svg viewBox="0 0 560 320" role="img" aria-label="Cameras feed three hosts run by one control plane, and the hosts serve the live view.">
      <g class="routes">
        {routes.map((d, i) => <path class="route" d={d} pathLength="1" style={`--i: ${i}`} />)}
      </g>
      <g class="packets">
        {
          packets.map(({ path, begin }) => (
            <g class="packet" visibility="hidden">
              <circle class="halo" r="9" />
              <circle class="core" r="3.5" />
              <set attributeName="visibility" to="visible" begin={begin} fill="freeze" />
              <animateMotion dur="3.2s" begin={begin} repeatCount="indefinite" path={path} />
            </g>
          ))
        }
      </g>
      <g class="part" style="--at: 0.35s">
        <rect class="box" x="16" y="128" width="124" height="64" rx="12" />
        <text class="label" x="32" y="157">Cameras</text>
        <text class="sub" x="32" y="177">RTSP, ONVIF</text>
      </g>
      <g class="part" style="--at: 0.45s">
        <rect class="plane" x="180" y="20" width="200" height="280" rx="16" />
        <text class="label" x="196" y="49">Control plane</text>
        <text class="sub" x="364" y="49" text-anchor="end">FastAPI</text>
      </g>
      {
        hosts.map(({ name, y, load, pace }, i) => (
          <g class="part" style={`--at: ${(0.55 + i * 0.08).toFixed(2)}s`}>
            <rect class="box" x="196" y={y} width="168" height="56" rx="10" />
            <circle class="pulse" cx="214" cy={y + 28} r="3.5" />
            <circle class="status" cx="214" cy={y + 28} r="3.5" />
            <text class="host" x="228" y={y + 32}>{name}</text>
            <rect class="track" x="300" y={y + 26} width="48" height="4" rx="2" />
            <rect class="load" x="300" y={y + 26} width={48 * load} height="4" rx="2" style={`--pace: ${pace}`} />
          </g>
        ))
      }
      <g class="part" style="--at: 0.8s">
        <rect class="box" x="420" y="128" width="124" height="64" rx="12" />
        <text class="label" x="436" y="157">Live view</text>
        <text class="sub" x="436" y="177">Operators</text>
      </g>
    </svg>
  </div>
  <figcaption>
    The architecture I designed at ESSI: a FastAPI control plane runs a fleet of video servers as one system.
  </figcaption>
</figure>

<style>
  .system {
    position: relative;
  }

  .system::before {
    content: '';
    position: absolute;
    inset: -12% -8%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(110 161 255 / 0.13), transparent);
    pointer-events: none;
  }

  .window {
    overflow: hidden;
    border: 1px solid var(--border-2);
    border-radius: 16px;
    background: rgb(18 21 28 / 0.86);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 40px 80px -32px rgb(0 0 0 / 0.7);
    backdrop-filter: blur(6px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.2rem 1rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--step--2);
    white-space: nowrap;
  }

  .name {
    color: var(--text-2);
    font-weight: 500;
  }

  .stat {
    color: var(--text-2);
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .stat strong {
    color: var(--accent);
    font-weight: 500;
  }

  svg {
    width: 100%;
    height: auto;
  }

  .route {
    fill: none;
    stroke: var(--border-2);
    stroke-width: 1.25;
  }

  .halo {
    fill: var(--accent);
    opacity: 0.3;
  }

  .core {
    fill: #dbe7ff;
  }

  .packet {
    display: none;
  }

  .box {
    fill: var(--surface-2);
    stroke: var(--border-2);
  }

  .plane {
    fill: rgb(110 161 255 / 0.04);
    stroke: rgb(110 161 255 / 0.4);
    stroke-dasharray: 4 5;
  }

  .label {
    fill: var(--text);
    font-size: 15px;
    font-weight: 500;
  }

  .sub {
    fill: var(--muted);
    font-family: var(--mono);
    font-size: 12.5px;
  }

  .host {
    fill: var(--text);
    font-family: var(--mono);
    font-size: 13.5px;
  }

  .status {
    fill: var(--accent);
  }

  .pulse {
    fill: var(--accent);
    opacity: 0;
  }

  .track {
    fill: var(--border-2);
  }

  .load {
    fill: var(--accent);
  }

  figcaption {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 40rem) {
    .label {
      font-size: 20px;
    }

    .host {
      font-size: 18px;
    }

    .sub,
    .track,
    .load {
      display: none;
    }
  }

  @media print {
    .window {
      background: var(--surface);
      box-shadow: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .window {
      animation: window-in 0.8s var(--ease) 0.15s both;
    }

    .route {
      stroke-dasharray: 1 1;
      animation: trace 0.9s var(--ease) calc(0.6s + var(--i) * 0.12s) both;
    }

    .part {
      animation: part-in 0.6s var(--ease) var(--at) both;
    }

    .packet {
      display: inline;
    }

    .pulse {
      transform-box: fill-box;
      transform-origin: center;
      animation: ping 2.4s ease-out 1.6s infinite;
    }

    .load {
      transform-box: fill-box;
      transform-origin: left;
      animation: breathe var(--pace) ease-in-out 1.4s infinite alternate;
    }
  }

  @keyframes window-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.98);
    }
  }

  @keyframes trace {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes part-in {
    from {
      opacity: 0;
    }
  }

  @keyframes ping {
    from {
      opacity: 0.55;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(3.2);
    }
  }

  @keyframes breathe {
    to {
      transform: scaleX(0.7);
    }
  }
</style>
