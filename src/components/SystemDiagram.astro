---
import { platform } from '../data/platform';
import { results } from '../data/results';

const scale = results.find((result) => result.id === 'cameras')!;
const shelves = platform.hosts.map((name, index) => ({ name, y: 110 + index * 38 })).reverse();
const streams = [
  { path: 'M80 184l37 18 44-22 31 15 35-17', begin: '0.3s' },
  { path: 'M343 194l43 22 41-20 23 11 51-25', begin: '0.9s' },
];
---

<figure class="system">
  <div class="bar">
    <p class="name">{platform.title}</p>
    <p class="scale">{scale.beforeText} to <strong>{scale.afterText}</strong> {platform.cameras.toLowerCase()}</p>
  </div>
  <div class="drawing">
    <svg viewBox="0 0 570 278" role="img" aria-label={platform.description}>
      <defs>
        <pattern id="floor-grid" width="40" height="20" patternUnits="userSpaceOnUse">
          <path d="M0 0l40 20M0 20L40 0" fill="none" stroke="var(--border-2)" stroke-width="0.7" />
        </pattern>
        <radialGradient id="floor-fade">
          <stop offset="0.2" stop-color="white" />
          <stop offset="1" stop-color="black" />
        </radialGradient>
        <mask id="floor-mask"><rect width="570" height="278" fill="url(#floor-fade)" /></mask>
        <linearGradient id="rack-lid" x2="1" y2="1">
          <stop class="lid-light" />
          <stop offset="1" class="lid-dark" />
        </linearGradient>
        <linearGradient id="control-lid" x2="0.8" y2="1">
          <stop class="control-light" />
          <stop offset="1" class="control-dark" />
        </linearGradient>
      </defs>

      <rect width="570" height="278" fill="url(#floor-grid)" mask="url(#floor-mask)" />
      <path class="base" d="M171 204l113-56 113 56v5l-113 56-113-56z" />
      <path class="base-edge" d="M171 204l113 56 113-56m-113 56v5" />

      <g class="streams">
        {streams.map(({ path, begin }) => (
          <g>
            <path class="conduit" d={path} />
            <path class="wire" d={path} />
            <g class="packet" visibility="hidden">
              <circle class="halo" r="6" />
              <circle class="core" r="2.4" />
              <set attributeName="visibility" to="visible" begin={begin} fill="freeze" />
              <animateMotion dur="2.8s" begin={begin} repeatCount="indefinite" path={path} />
            </g>
          </g>
        ))}
      </g>

      <g class="endpoints">
        <g transform="translate(76 177)">
          <path class="pad" d="M-40 0L0-20 40 0v6L0 26-40 6z" />
          <path class="rim" d="M-40 0L0 20 40 0M0 20v6" />
          <path class="stand" d="M-10-5v9l-12 6" />
          <path class="metal" d="M-26-22l17-9 33 15-17 9z" />
          <path class="side" d="M-26-22L7-7V8L-26-7z" />
          <path class="glass" d="M7-7l17-9v15L7 8z" />
          <ellipse class="lens" cx="15" cy="-4" rx="3.3" ry="4.5" transform="rotate(24 15 -4)" />
          <path class="rim" d="M-21-14l10 5" />
        </g>
        <g transform="translate(494 177)">
          <path class="pad" d="M-40 0L0-20 40 0v6L0 26-40 6z" />
          <path class="rim" d="M-40 0L0 20 40 0M0 20v6" />
          <path class="stand" d="M0-11V2m-10 5L10-3" />
          <path class="metal" d="M-24-28l44-22 4 2v33l-44 22-4-2z" />
          <path class="glass" d="M-20-26L24-48v33L-20 7z" />
          <path class="screen" d="M-15-24L19-41v23L-15-1zM2-32.5v23m-17-3L19-29" />
        </g>
        <text class="node-name" x="76" y="227">{platform.cameras}</text>
        <text class="detail" x="76" y="247">{platform.protocols}</text>
        <text class="node-name" x="494" y="227">{platform.output}</text>
        <text class="detail" x="494" y="247">{platform.audience}</text>
      </g>

      <path class="bus" d="M214 69l-24 12v99l16 8m-16-46 16 8m-16-46 16 8" />
      {shelves.map(({ name, y }, i) => (
        <g class="host-shelf" transform={`translate(284 ${y})`} style={`--travel: ${12 - 9 * i}px`}>
          <path class="metal" d="M-84 0L0-42 84 0 0 42z" />
          <path class="side" d="M-84 0L0 42v21l-84-42z" />
          <path class="front" d="M0 42L84 0v21L0 63z" />
          <path class="etch" d="M-69 0l69 34 69-34M-42-1l38 19m-29-23L5 14m-29-23L14 10" />
          <g transform="matrix(1 .5 0 1 -76 9)">
            <circle class="lamp" cy="3.5" r="2" />
            <text class="host" x="8" y="7">{name}</text>
          </g>
          <g class="ports" transform="matrix(1 -.5 0 1 10 44)">
            <path d="M0 1h16v5H0zM21 1h16v5H21z" />
            <path class="vents" d="M45 0v7m4-7v7m4-7v7m4-7v7m4-7v7" />
          </g>
        </g>
      ))}

      <g class="controller">
        <g transform="translate(284 65)">
          <path class="cap-side" d="M-86 0L0 43l86-43v12L0 55-86 12z" />
          <path class="cap" d="M-86 0L0-43 86 0 0 43z" />
          <path class="etch" d="M-72 0L0-36 72 0 0 36z" />
          <g transform="matrix(1 .5 -1 .5 0 0)">
            <path class="pins" d="M-13-26v7m8-7v7m9-7v7m9-7v7m-26 38v7m8-7v7m9-7v7m9-7v7M-26-13h7m-7 8h7m-7 9h7m-7 9h7m38-26h7m-7 8h7m-7 9h7m-7 9h7" />
            <rect class="die" x="-19" y="-19" width="38" height="38" rx="3" />
            <rect class="circuit" x="-12" y="-12" width="24" height="24" rx="2" />
          </g>
          <path class="seam" d="M-77 8L0 46l77-38" />
        </g>
        <path class="leader" d="M345 53l43-22h16" />
        <circle class="lamp" cx="345" cy="53" r="2" />
        <text class="callout" x="414" y="35">{platform.control}</text>
        <text class="callout-detail" x="414" y="54">{platform.framework}</text>
      </g>
    </svg>
  </div>
  <fieldset class="views">
    <legend class="visually-hidden">{platform.viewLabel}</legend>
    {platform.views.map((view, i) => (
      <div>
        <input class="visually-hidden" type="radio" name="platform-view" id={`view-${view.id}`}
          aria-describedby={`note-${view.id}`} checked={i === 0} />
        <label for={`view-${view.id}`}>{view.label}</label>
      </div>
    ))}
  </fieldset>
  <figcaption>
    {platform.views.map((view) => <span id={`note-${view.id}`}>{view.note}</span>)}
  </figcaption>
</figure>

<style>
  .system {
    overflow: hidden;
    border: 1px solid var(--border-2);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: 0 24px 60px -42px color-mix(in srgb, var(--border-2) 45%, transparent);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.15rem 1rem;
    padding: 0.85rem var(--inset);
    border-bottom: 1px solid var(--border);
  }

  .name {
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 550;
  }

  .scale, .detail, .callout-detail, .host {
    font-family: var(--mono);
  }

  .scale {
    color: var(--muted);
    font-size: var(--step--2);
  }

  .scale strong {
    color: var(--text-2);
  }

  .drawing {
    padding: 0.35rem 0;
    background: radial-gradient(ellipse at 50% 48%, var(--glow), transparent 69%);
  }

  svg {
    width: 100%;
    height: auto;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .lid-light { stop-color: color-mix(in srgb, var(--accent) 19%, var(--surface-2)); }
  .lid-dark { stop-color: var(--surface-2); }
  .control-light { stop-color: color-mix(in srgb, var(--accent) 56%, var(--surface)); }
  .control-dark { stop-color: color-mix(in srgb, var(--accent) 19%, var(--surface)); }

  .base, .pad {
    fill: var(--surface);
    stroke: var(--border-2);
  }

  .base-edge, .etch, .rim, .leader {
    fill: none;
    stroke: var(--muted);
    stroke-opacity: 0.55;
  }

  .base-edge, .etch { stroke-opacity: 0.32; }
  .base-edge { stroke: var(--accent); }
  .metal { fill: url(#rack-lid); }
  .side { fill: var(--surface-2); }
  .front { fill: var(--surface); }
  .metal, .side, .front, .stand { stroke: color-mix(in srgb, var(--muted) 42%, var(--border)); }
  .stand { fill: none; stroke-width: 2.5; }
  .glass, .ports { fill: var(--bg); stroke: var(--muted); }
  .ports, .vents { stroke-width: 0.8; }
  .screen { fill: var(--glow); stroke: var(--accent); }
  .lens, .lamp, .core { fill: var(--accent); }

  .bus, .wire, .conduit, .seam {
    fill: none;
    stroke: var(--accent);
  }

  .bus { stroke-dasharray: 3 4; stroke-opacity: 0.6; }
  .conduit { stroke: var(--border-2); stroke-width: 4; }
  .wire { stroke-opacity: 0.82; stroke-width: 1.4; }
  .halo { fill: var(--accent); opacity: 0.22; }
  .packet { display: none; }
  .cap { fill: url(#control-lid); stroke: var(--accent); }
  .cap-side { fill: color-mix(in srgb, var(--accent) 16%, var(--surface)); stroke: var(--accent); }
  .pins, .circuit { fill: none; stroke: var(--accent); stroke-width: 1.5; }
  .die { fill: var(--surface); stroke: var(--accent); }
  .circuit { fill: var(--glow); }
  .seam { stroke-opacity: 0.6; }

  .node-name, .callout {
    fill: var(--text);
    font-size: 15px;
    font-weight: 550;
  }

  .node-name, .detail { text-anchor: middle; }
  .detail, .callout-detail { fill: var(--muted); font-size: 12px; }
  .host { fill: var(--text-2); font-size: 12px; }

  .views {
    display: flex;
    width: fit-content;
    max-width: 100%;
    gap: 2px;
    margin: 0 var(--inset);
    padding: 3px;
    border: 1px solid var(--border-2);
    border-radius: 0.65rem;
    background: var(--bg);
  }

  .views label {
    display: grid;
    min-height: 2.25rem;
    align-content: center;
    padding-inline: 0.85rem;
    border-radius: 0.4rem;
    color: var(--muted);
    font-size: var(--step--2);
    font-weight: 500;
    cursor: pointer;
  }

  .views label:hover { color: var(--text); }
  input:checked + label { color: var(--text); background: var(--surface-2); }
  input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 1px; }

  figcaption {
    display: grid;
    min-height: 4.7rem;
    padding: 0.8rem var(--inset) 1.15rem;
    color: var(--text-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  figcaption span {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  #note-overview { visibility: visible; }
  .system:has(input:not(#view-overview):checked) #note-overview { visibility: hidden; }
  .system:has(#view-allocation:checked) #note-allocation,
  .system:has(#view-playback:checked) #note-playback { visibility: visible; }

  @supports not selector(:has(input:checked)) {
    .views { display: none; }
    figcaption { gap: 0.5rem; }
    figcaption span { grid-area: auto; visibility: visible; }
  }

  .system:has(#view-allocation:checked) :is(.endpoints > g, .streams) { opacity: 0.4; }
  .system:has(#view-allocation:checked) .bus { stroke-width: 2; stroke-opacity: 1; }
  .system:has(#view-playback:checked) :is(.controller > g, .bus) { opacity: 0.4; }
  .system:has(#view-playback:checked) .wire { stroke-width: 2.3; stroke-opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .packet { display: inline; }
    .host-shelf { translate: 0 calc(var(--spread, 0) * var(--travel)); }
    .controller { translate: 0 calc(var(--spread, 0) * -18px); }
    .endpoints > g, .streams, .controller > g, .bus { transition: opacity 0.2s; }
    .system:has(#view-allocation:checked) .bus { animation: assign-host 1.4s linear infinite; }
  }

  @keyframes assign-host {
    to { stroke-dashoffset: -14; }
  }

  @media (max-width: 40rem) {
    .views { width: calc(100% - 2 * var(--inset)); }
    .views div { flex: 1 1 auto; text-align: center; }
    .views label { min-height: 2.75rem; padding-inline: 0.35rem; }
    .node-name, .callout { font-size: 20px; }
    .detail, .callout-detail { font-size: 16px; }
    .host { font-size: 14px; }
  }

  @media (forced-colors: active) {
    input:checked + label { outline: 1px solid Highlight; }
  }
</style>
