---
import { education, roles } from '../data/experience';
import { areas } from '../data/skills';

const names = new Map(areas.map((area) => [area.id, area.name]));
const period = (start: string, end: string) => `${start} to ${end === 'Present' ? 'now' : end}`;
const parts = (text: string) => text.split(/\*\*(.+?)\*\*/);
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <h2 class="title" id="experience-title">Experience</h2>
    <ol class="timeline" role="list">
      {
        roles.map((role) => (
          <li class="entry" id={role.id}>
            <span class="fill" aria-hidden="true" />
            <div class="meta">
              <span class="node" aria-hidden="true" />
              <p class="period">{period(role.start, role.end)}</p>
              <h3>{role.title}</h3>
              <p class="company">{role.company}</p>
              <p class="place">{role.place}</p>
            </div>
            <div class="details">
              {role.groups.map((group) => (
                <div class="group">
                  <h4>{names.get(group.area)}</h4>
                  <ul role="list">
                    {group.points.map((point) => (
                      <li>{parts(point).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </li>
        ))
      }
      <li class="entry" id="education">
        <div class="meta">
          <span class="node" aria-hidden="true" />
          <p class="period">{period(education.start, education.end)}</p>
          <h3>{education.degree}</h3>
          <p class="company">{education.school}</p>
          <p class="place">{education.place}</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<script>
  const timeline = document.querySelector<HTMLElement>('#experience .timeline');

  if (timeline && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const entries = [...timeline.querySelectorAll<HTMLElement>('.entry')];
    let queued = false;

    const update = () => {
      queued = false;
      const mark = innerHeight * 0.6;
      for (const entry of entries) {
        const node = entry.querySelector<HTMLElement>('.node')!;
        const { top, height } = entry.getBoundingClientRect();
        const start = top + node.offsetTop + node.offsetHeight / 2;
        entry.style.setProperty('--f', String(Math.min(1, Math.max(0, (mark - start) / height))));
        entry.classList.toggle('is-reached', mark >= start);
      }
    };

    const request = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    timeline.classList.add('is-filling');
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    update();
  }
</script>

<style>
  .timeline {
    --pad: clamp(1.5rem, 0.75rem + 2.5vw, 2.5rem);
    --node: 11px;
    --at: 0.625rem;
    margin-top: 3rem;
  }

  .entry {
    position: relative;
    padding: 0 0 clamp(3.5rem, 2.5rem + 3vw, 5rem) var(--pad);
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .meta {
    position: relative;
  }

  .node {
    position: absolute;
    top: calc(var(--at) - var(--node) / 2);
    left: calc(-1 * var(--pad));
    width: var(--node);
    height: var(--node);
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: var(--bg);
  }

  .entry:not(:last-child)::before,
  .fill {
    content: '';
    position: absolute;
    top: var(--at);
    left: calc(var(--node) / 2 - 0.5px);
    width: 1px;
    height: 100%;
    background: var(--border);
  }

  .fill {
    display: none;
    background: var(--accent);
    box-shadow: 0 0 6px rgb(110 161 255 / 0.5);
    transform: scaleY(var(--f, 0));
    transform-origin: top;
  }

  .period {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin-top: 0.5rem;
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .company {
    margin-top: 0.5rem;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .place {
    margin-top: 0.125rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .details {
    display: grid;
    gap: 2.25rem;
    max-width: var(--measure);
    margin-top: 2rem;
  }

  @media (min-width: 64rem) {
    .entry {
      display: grid;
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 1rem + 3vw, 4.5rem);
      align-items: start;
    }

    .meta {
      position: sticky;
      top: 6rem;
    }

    .details {
      margin-top: 0;
    }
  }

  h4 {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.25rem;
    letter-spacing: 0;
  }

  h4::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .group ul {
    display: grid;
    gap: 0.875rem;
    margin-top: 1rem;
  }

  .group li {
    position: relative;
    padding-left: 1.125rem;
    line-height: 1.65;
  }

  .group li strong {
    white-space: nowrap;
  }

  .group li::before {
    content: '';
    position: absolute;
    top: calc(0.825em - 2px);
    left: 0.125rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--muted);
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .is-filling .fill {
      display: block;
    }

    .node {
      transition:
        background-color 0.3s var(--ease),
        border-color 0.3s var(--ease),
        box-shadow 0.3s var(--ease);
    }

    .is-reached .node {
      border-color: var(--accent);
      background: var(--accent);
      box-shadow: 0 0 0 4px var(--glow);
    }
  }

  @media print {
    .meta {
      position: relative;
      top: 0;
    }

    .group {
      break-inside: avoid;
    }
  }
</style>
