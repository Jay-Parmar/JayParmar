---
import { education, roles } from '../data/experience';
import { lines } from '../data/lines';

const names = new Map(lines.map((line) => [line.id, line.name]));
const period = (start: string, end: string) => `${start} to ${end === 'Present' ? 'now' : end}`;
const parts = (text: string) => text.split(/\*\*(.+?)\*\*/);
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <h2 class="title" id="experience-title">Experience</h2>
    <ol class="timeline" role="list">
      {
        roles.map((role) => (
          <li class="stop" id={role.id}>
            <span class="fill" aria-hidden="true" />
            <div class="head">
              <p class="when">{period(role.start, role.end)}</p>
              <h3>{role.title}</h3>
              <p class="where">
                {role.company}, {role.place}
              </p>
            </div>
            <div class="body">
              {role.groups.map((group) => (
                <div class="group">
                  <h4>{names.get(group.line)}</h4>
                  <ul role="list">
                    {group.points.map((point) => (
                      <li>{parts(point).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </li>
        ))
      }
      <li class="stop" id="education">
        <div class="head">
          <p class="when">{period(education.start, education.end)}</p>
          <h3>{education.degree}</h3>
          <p class="where">{education.school}, {education.place}</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<script>
  const timeline = document.querySelector<HTMLElement>('.timeline');

  if (timeline && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const stops = [...timeline.querySelectorAll<HTMLElement>('.stop')];
    let queued = false;

    const update = () => {
      queued = false;
      const mark = innerHeight * 0.6;
      for (const stop of stops) {
        const { top, height } = stop.getBoundingClientRect();
        const start = top + 16;
        stop.style.setProperty('--f', String(Math.min(1, Math.max(0, (mark - start) / height))));
        stop.classList.toggle('is-reached', mark >= start);
      }
    };

    const request = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    timeline.classList.add('is-filling');
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    update();
  }
</script>

<style>
  .timeline {
    --x: 0.9rem;
    --dot: 1.5rem;
    --pad: clamp(2.75rem, 2rem + 2vw, 3.5rem);
    margin-top: 3rem;
    padding-left: var(--pad);
  }

  .stop {
    position: relative;
    padding-bottom: 3.5rem;
  }

  .stop:last-child {
    padding-bottom: 0;
  }

  .stop::before,
  .stop::after,
  .fill {
    content: '';
    position: absolute;
    left: calc(var(--x) - var(--pad));
  }

  .stop::before {
    z-index: 2;
    top: 0.25rem;
    width: var(--dot);
    height: var(--dot);
    margin-left: calc(var(--line) / 2 - var(--dot) / 2);
    border: 4px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    transition: background-color 0.25s;
  }

  .stop:not(:last-child)::after,
  .fill {
    top: calc(0.25rem + var(--dot) / 2);
    width: var(--line);
    height: 100%;
    background: var(--ink);
  }

  .fill {
    z-index: 1;
    transform: scaleY(var(--f, 1));
    transform-origin: top;
  }

  .is-filling .stop:not(:last-child)::after {
    background: var(--track);
  }

  .is-filling .stop.is-reached::before {
    background: var(--ink);
  }

  .when {
    font-weight: 500;
    color: var(--muted);
  }

  h3 {
    margin-top: 0.15rem;
    font-size: var(--step-3);
  }

  .where {
    margin-top: 0.35rem;
    font-size: var(--step-1);
  }

  .group {
    max-width: var(--measure);
    margin-top: 2.25rem;
  }

  @media (min-width: 64rem) {
    .stop {
      display: grid;
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      column-gap: 3.5rem;
      align-items: start;
    }

    .head {
      position: sticky;
      top: 6rem;
    }

    h3 {
      font-size: var(--step-2);
    }

    .where {
      font-size: var(--step-0);
    }

    .body > .group:first-child {
      margin-top: 0.35rem;
    }
  }

  h4 {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.25rem;
    letter-spacing: 0;
  }

  h4::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .group ul {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .group li {
    position: relative;
    padding-left: 1rem;
  }

  .group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--ink);
  }
</style>
