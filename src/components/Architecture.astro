---
import { platform } from '../data/platform';
import SystemDiagram from './SystemDiagram.astro';
---

<section class="architecture" id="architecture" aria-labelledby="architecture-title">
  <div class="wrap">
    <header>
      <p class="label">{platform.section}</p>
      <h2 id="architecture-title">{platform.headline}</h2>
      <p class="summary">{platform.introduction}</p>
    </header>
    <div class="study">
      <div class="stage"><SystemDiagram /></div>
      <ol class="chapters" role="list">
        {platform.views.map((view) => (
          <li id={`chapter-${view.id}`} data-view={view.id}>
            <h3>{view.heading}</h3>
            <p>{view.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .architecture {
    padding-block: clamp(3rem, 6vw, 6rem);
    border-block: 1px solid var(--border);
    background: var(--bg-raised);
  }

  header { max-width: 52rem; }
  .label { color: var(--accent); font-size: var(--step--1); font-weight: 550; }
  h2 {
    margin-top: 0.7rem;
    font-size: clamp(2.25rem, 4.7vw, 4.2rem);
    font-weight: 525;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }

  .summary { max-width: 62ch; margin-top: 1rem; }
  .study { display: grid; gap: 1.6rem; margin-top: clamp(2rem, 4vw, 3.5rem); }
  .stage { min-width: 0; }
  .chapters li { border-top: 1px solid var(--border-2); padding-block: 1.25rem; }
  h3 { font-size: var(--step-2); font-weight: 550; letter-spacing: -0.035em; }
  .chapters p { max-width: 41ch; margin-top: 0.65rem; }
  @media (min-width: 57rem) {
    .study { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(3rem, 7vw, 7rem); }
    .stage { grid-column: 2; grid-row: 1; align-self: start; }
    .chapters { grid-column: 1; grid-row: 1; }
  }
</style>
