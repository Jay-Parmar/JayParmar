---
import { profile, themeLabel } from '../data/profile';
import { link } from '../lib/url';

interface Props {
  home?: boolean;
  current?: string;
}

const { home = false, current } = Astro.props;
const sections = [
  { id: 'architecture', name: 'Architecture' },
  { id: 'results', name: 'Impact' },
  { id: 'projects', name: 'Projects' },
  { id: 'experience', name: 'Experience' },
  { id: 'skills', name: 'Skills' },
];
const to = (id: string) => (home ? `#${id}` : link(`#${id}`));
const target = (id: string) => (home ? id : undefined);
---

<header class="nav">
  <div class="wrap inner">
    <a class="brand" href={home ? '#top' : link()}>
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
        <use href={link('favicon.svg#monogram')} />
      </svg>
      {profile.name}
    </a>
    <nav aria-label="Sections">
      <button class="toggle" type="button" popovertarget="sections">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path class="top" d="M3 7h14"></path><path class="bottom" d="M3 13h14"></path></svg>
        <span class="visually-hidden">Menu</span>
      </button>
      <ul class="links" id="sections" role="list" popover>
        {
          sections.map((section) => (
            <li>
              <a href={to(section.id)} data-target={target(section.id)} aria-current={section.id === current ? 'true' : undefined}>
                {section.name}
              </a>
            </li>
          ))
        }
        <li class="cta">
          <a class="button primary" href={to('contact')} data-target={target('contact')}>Get in touch</a>
        </li>
      </ul>
    </nav>
    <button id="theme-switch" class="theme-switch" type="button" aria-label={themeLabel} title={themeLabel} hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <g class="sun">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </g>
        <path class="moon" d="M19.8 14.4A8.2 8.2 0 0 1 9.6 4.2a8.4 8.4 0 1 0 10.2 10.2Z" />
      </svg>
    </button>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('header.nav');

  if (nav) {
    const menu = nav.querySelector<HTMLElement>('#sections');
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-target]')];
    const sections = links.map((link) => document.getElementById(link.dataset.target ?? ''));
    let queued = false;

    const update = () => {
      queued = false;
      nav.classList.toggle('is-scrolled', scrollY > 4);
      if (!links.length) return;
      const mark = innerHeight * 0.35;
      const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const current = atEnd
        ? links.length - 1
        : sections.findLastIndex((section) => section !== null && section.getBoundingClientRect().top <= mark);
      links.forEach((link, i) => {
        if (i === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const request = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    if (menu && CSS.supports('selector(:popover-open)')) {
      menu.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a') && menu.matches(':popover-open')) {
          menu.hidePopover();
        }
      });
      matchMedia('(min-width: 56rem)').addEventListener('change', (event) => {
        if (event.matches && menu.matches(':popover-open')) menu.hidePopover();
      });
    }
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    update();
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
  }

  :global(.js) .nav:not(.is-scrolled) {
    border-bottom-color: transparent;
    background: transparent;
    backdrop-filter: none;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 4rem;
  }

  nav { margin-left: auto; }

  .theme-switch {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--border-2);
    border-radius: 50%;
    color: var(--text-2);
    background: var(--surface);
    cursor: pointer;
  }

  @media (min-width: 56rem) {
    .theme-switch {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  .theme-switch:hover {
    color: var(--text);
    border-color: var(--muted);
  }

  .theme-switch svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-switch[hidden],
  .theme-switch[aria-pressed='true'] .sun,
  .theme-switch[aria-pressed='false'] .moon {
    display: none;
  }

  .brand {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .mark {
    width: 2.125rem;
    height: 2.125rem;
    flex: none;
    fill: var(--accent);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    overflow: visible;
    position: static;
    inset: auto;
  }

  .links a:not(.button) {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }

  .links a:not(.button):hover {
    color: var(--text);
  }

  .links a[aria-current]:not(.button) {
    background: var(--surface-2);
    color: var(--text);
  }

  .cta {
    margin-left: 0.75rem;
  }

  .cta .button {
    min-height: 2.25rem;
    padding-inline: 0.95rem;
  }

  .toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--border-2);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .toggle svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .toggle path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav {
      transition:
        background-color 0.3s,
        border-color 0.3s;
    }

    .links a:not(.button) {
      transition:
        color 0.2s,
        background-color 0.2s;
    }

    .toggle path {
      transition: transform 0.25s var(--ease);
    }
  }

  .nav:has(.links:popover-open) .toggle {
    background: var(--surface-2);
  }

  .nav:has(.links:popover-open) .top {
    transform: translateY(3px) rotate(45deg);
  }

  .nav:has(.links:popover-open) .bottom {
    transform: translateY(-3px) rotate(-45deg);
  }

  .links::backdrop {
    inset: 4rem 0 0;
    background: color-mix(in srgb, var(--bg) 65%, transparent);
  }

  @supports selector(:popover-open) {
    @media (max-width: 55.99rem) {
      .toggle {
        display: grid;
      }

      .links {
        display: none;
      }

      .links:popover-open {
        position: fixed;
        inset: 4.25rem var(--gutter) auto auto;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.15rem;
        width: min(18rem, calc(100vw - 2 * var(--gutter)));
        max-height: calc(100dvh - 5rem);
        overflow-y: auto;
        padding: 0.5rem;
        border: 1px solid var(--border-2);
        border-radius: var(--radius);
        background: var(--surface);
        box-shadow: 0 24px 48px color-mix(in srgb, var(--border-2) 32%, transparent);
      }

      .links:popover-open a:not(.button) {
        padding: 0.7rem 0.85rem;
        color: var(--text-2);
        font-size: var(--step-0);
      }

      .links:popover-open .cta {
        margin: 0.35rem 0 0;
      }

      .links:popover-open .cta .button {
        width: 100%;
        min-height: 2.75rem;
      }
    }
  }

  @supports not selector(:popover-open) {
    @media (max-width: 55.99rem) {
      .inner {
        flex-wrap: wrap;
        padding-block: 0.75rem;
      }

      .links {
        flex-wrap: wrap;
      }
    }
  }
</style>
