---
import { profile } from '../data/profile';

const [user, domain] = profile.email.split('@');
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="panel card">
      <h2 class="title" id="contact-title">Get in touch</h2>
      <p class="note">Email is the quickest way to reach me.</p>
      <div class="address">
        <a class="email" href={`mailto:${profile.email}`}>{user}@<wbr />{domain}</a>
        <button class="button copy" type="button" data-copy={profile.email} aria-label="Copy email address" hidden>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <g class="sheets">
              <rect x="7.5" y="7.5" width="9" height="9" rx="2"></rect>
              <path d="M12.5 7.5v-2a2 2 0 0 0-2-2h-5a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h2"></path>
            </g>
            <path class="tick" d="M4.5 10.5l3.5 3.5 7.5-8"></path>
          </svg>
          <span class="label">Copy</span>
        </button>
      </div>
      <p class="visually-hidden" aria-live="polite"></p>
      <div class="actions">
        <a class="button" href={profile.linkedin}>LinkedIn</a>
        <a class="button" href={profile.github}>GitHub</a>
      </div>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('#contact [data-copy]');
  const status = document.querySelector<HTMLElement>('#contact [aria-live]');
  const email = document.querySelector<HTMLElement>('#contact .email');

  if (button && status && email && navigator.clipboard) {
    const label = button.querySelector<HTMLElement>('.label')!;
    let reset = 0;

    const copied = () => {
      button.classList.add('is-copied');
      label.textContent = status.textContent = 'Copied';
      clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.classList.remove('is-copied');
        label.textContent = 'Copy';
        status.textContent = '';
      }, 2000);
    };

    button.hidden = false;
    button.addEventListener('click', () => {
      navigator.clipboard.writeText(button.dataset.copy ?? '').then(copied, () => {
        getSelection()?.selectAllChildren(email);
        status.textContent = "Couldn't copy. The address is selected instead.";
      });
    });
  }
</script>

<style>
  .contact {
    padding-bottom: var(--section);
  }

  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3.5rem, 2rem + 5vw, 6rem) clamp(1.25rem, 0.5rem + 3vw, 3rem);
    background:
      radial-gradient(ellipse 55% 75% at 50% 0%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 70%),
      var(--surface);
    text-align: center;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0 18% auto;
    height: 1px;
    background: linear-gradient(to right, transparent, color-mix(in srgb, var(--accent) 65%, transparent), transparent);
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--text) 3.5%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--text) 3.5%, transparent) 1px, transparent 1px);
    background-position: center top;
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 60% 85% at 50% 0%, #000 25%, transparent 80%);
  }

  .note {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: var(--step-1);
    text-wrap: balance;
  }

  .address {
    display: grid;
    justify-items: center;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 2.75rem);
  }

  @media (min-width: 50rem) {
    .address {
      grid-template-columns: 1fr auto 1fr;
    }

    .email {
      grid-column: 2;
    }

    .copy {
      justify-self: start;
    }
  }

  .email {
    color: var(--text);
    font-size: clamp(1.125rem, 5.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .copy {
    gap: 0.45rem;
    min-width: 6.5rem;
    padding-inline: 0.9rem 1rem;
  }

  .copy[hidden] {
    display: none;
  }

  .copy svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .copy .tick {
    stroke: var(--accent);
    stroke-width: 1.75;
    opacity: 0;
  }

  .copy.is-copied {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .is-copied .sheets {
    opacity: 0;
  }

  .is-copied .tick {
    opacity: 1;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 2.75rem);
  }

  @media (max-width: 29.99rem) {
    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheets,
    .tick {
      transform-box: fill-box;
      transform-origin: center;
      transition:
        opacity 0.2s,
        transform 0.35s var(--ease);
    }

    .tick,
    .is-copied .sheets {
      transform: scale(0.6);
    }

    .is-copied .tick {
      transform: none;
    }
  }

  @media print {
    .contact {
      padding-bottom: 0;
    }

    .card {
      background: none;
    }

    .card::before,
    .card::after,
    .copy {
      display: none;
    }
  }
</style>
