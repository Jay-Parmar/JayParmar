---
import { lines } from '../data/lines';
import { profile } from '../data/profile';
---

<section class="contact night" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="arrival">
      <div class="terminus" aria-hidden="true">
        <div class="tracks">
          {lines.map((line, i) => <span style={`--c: var(--${line.id}); --i: ${i}`} />)}
        </div>
        <span class="stop" />
      </div>
      <h2 class="title" id="contact-title">Contact</h2>
    </div>
    <p class="note">Email is the quickest way to reach me.</p>
    <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <ul class="links" role="list">
      <li><a href={profile.linkedin}>LinkedIn</a></li>
      <li><a href={profile.github}>GitHub</a></li>
    </ul>
  </div>
</section>

<script>
  const terminus = document.querySelector<HTMLElement>('.terminus');

  if (terminus && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    terminus.classList.add('is-waiting');
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void terminus.offsetWidth;
        terminus.classList.replace('is-waiting', 'is-arriving');
      },
      { threshold: 0.5 },
    );
    observer.observe(terminus);
  }
</script>

<style>
  .contact {
    padding-block: var(--section);
    overflow-x: clip;
    background: var(--band);
    color: var(--band-ink);
  }

  .contact :focus-visible {
    outline-color: var(--band-ink);
  }

  .arrival {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .terminus {
    --bleed: calc(50vw - 50%);
    display: flex;
    flex: none;
    align-items: center;
    width: calc(var(--bleed) + clamp(3rem, 12vw, 9rem));
    margin-left: calc(-1 * var(--bleed));
  }

  .tracks {
    display: grid;
    flex: 1;
    gap: 3px;
  }

  .tracks span {
    display: block;
    height: var(--line);
    border-radius: 0 99px 99px 0;
    background: var(--c);
    transform-origin: left;
  }

  .stop {
    flex: none;
    width: 1.4rem;
    height: calc(5 * var(--line) + 4 * 3px + 0.9rem);
    margin-left: -0.7rem;
    border: 4px solid var(--band-ink);
    border-radius: 99px;
    background: var(--band);
  }

  .is-waiting .tracks span {
    transform: scaleX(0);
  }

  .is-waiting .stop {
    opacity: 0;
    transform: scale(0.4);
  }

  .is-arriving .tracks span {
    transition: transform 1s cubic-bezier(0.3, 0, 0.2, 1) calc(var(--i) * 90ms);
  }

  .is-arriving .stop {
    transition:
      transform 0.45s cubic-bezier(0.3, 1.5, 0.5, 1) 1.2s,
      opacity 0.2s 1.2s;
  }

  .note {
    margin-top: 0.75rem;
    font-size: var(--step-1);
    color: var(--band-muted);
  }

  .email {
    display: inline-block;
    margin-top: 2rem;
    font-size: clamp(1.25rem, 6.8vw, 2.25rem);
    font-weight: 700;
    overflow-wrap: break-word;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    font-weight: 500;
  }
</style>
