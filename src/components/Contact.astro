---
import { profile } from '../data/profile';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="panel card">
      <h2 class="title" id="contact-title">Get in touch</h2>
      <p class="note">Email is the quickest way to reach me.</p>
      <p class="address">
        <span class="email">{profile.email}</span>
      </p>
      <div class="actions">
        <a class="button primary" href={`mailto:${profile.email}`}>Email me</a>
        <a class="button" href={profile.linkedin}>LinkedIn</a>
        <a class="button" href={profile.github}>GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: var(--section);
  }

  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3.5rem, 2rem + 5vw, 6rem) clamp(1.25rem, 0.5rem + 3vw, 3rem);
    background:
      radial-gradient(ellipse 55% 75% at 50% 0%, rgb(110 161 255 / 0.15), transparent 70%),
      var(--surface);
    text-align: center;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0 18% auto;
    height: 1px;
    background: linear-gradient(to right, transparent, rgb(110 161 255 / 0.65), transparent);
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-position: center top;
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 60% 85% at 50% 0%, #000 25%, transparent 80%);
  }

  .note {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: var(--step-1);
    text-wrap: balance;
  }

  .address {
    margin-top: clamp(2rem, 1.5rem + 2vw, 2.75rem);
  }

  .email {
    color: var(--text);
    font-size: clamp(1.375rem, 0.85rem + 2.6vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 2.75rem);
  }

  @media (max-width: 29.99rem) {
    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .primary {
      grid-column: 1 / -1;
    }
  }

  @media print {
    .contact {
      padding-bottom: 0;
    }

    .card {
      background: none;
    }

    .card::before,
    .card::after {
      display: none;
    }
  }
</style>
