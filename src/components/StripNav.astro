---
import { profile } from '../data/profile';

const stops = [
  { id: 'results', name: 'Results' },
  { id: 'experience', name: 'Experience' },
  { id: 'projects', name: 'Projects' },
  { id: 'skills', name: 'Skills' },
  { id: 'contact', name: 'Contact' },
];
---

<header class="bar">
  <div class="wrap inner">
    <a class="home" href="#top">{profile.name}</a>
    <span class="now" aria-hidden="true"></span>
    <nav class="strip" aria-label="Sections">
      <ol role="list">
        {
          stops.map((stop) => (
            <li>
              <a href={`#${stop.id}`} data-target={stop.id}>
                <span class="name">{stop.name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</header>


<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--track);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }

  .home {
    flex: none;
    font-weight: 800;
    text-decoration: none;
  }

  .now {
    display: none;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
  }

  .strip {
    --dot: 0.75rem;
    position: relative;
    flex: 1;
    max-width: 34rem;
    margin-left: auto;
  }

  .strip::before {
    content: '';
    position: absolute;
    top: calc(0.6rem + var(--dot) / 2 - 2px);
    left: 10%;
    right: 10%;
    height: 4px;
    border-radius: 99px;
    background: var(--ink);
  }

  ol {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  a[data-target] {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding-top: 0.6rem;
    padding-bottom: 0.4rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }

  a[data-target]::before {
    content: '';
    z-index: 1;
    width: var(--dot);
    height: var(--dot);
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
  }

  a[data-target]:hover,
  a[aria-current] {
    color: var(--ink);
  }

  a[aria-current] {
    font-weight: 700;
  }

  a.is-passed::before {
    background: var(--ink);
  }


  @media (max-width: 40rem) {
    .now {
      display: block;
    }

    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .strip {
      max-width: 11rem;
    }
  }
</style>
