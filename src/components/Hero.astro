---
import { roles } from '../data/experience';
import { heroLabels, profile } from '../data/profile';
import StackPortrait from './StackPortrait.astro';

const current = roles.find((role) => role.end === 'Present');
---

<section class="hero" id="top" aria-labelledby="name">
  <div class="wrap grid">
    <div class="text">
      <p class="location">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M16 8.5c0 4.1-6 9-6 9s-6-4.9-6-9a6 6 0 0 1 12 0Z" />
          <circle cx="10" cy="8.3" r="2" />
        </svg>
        {profile.location}
      </p>
      <h1 id="name">{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p class="intro">{profile.intro}</p>
      <div class="actions">
        <a class="button primary" href="#projects">{heroLabels.projects}</a>
        <a class="email" href={`mailto:${profile.email}`}>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <rect x="2.5" y="4.5" width="15" height="11" rx="2" />
            <path d="m3.5 6 6.5 4.8L16.5 6" />
          </svg>
          {heroLabels.email}
        </a>
      </div>
    </div>
    <div class="art"><StackPortrait /></div>
    {current && (
      <div class="current">
        <span>{heroLabels.current}</span>
        <a href={`#${current.id}`}>{current.title} at {current.company}</a>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2rem, 6vw, 6rem) clamp(2.5rem, 7vw, 7rem);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -4rem 0 0;
    z-index: -1;
    background: radial-gradient(ellipse at 76% 40%, var(--glow), transparent 55%);
    pointer-events: none;
  }

  .grid {
    display: grid;
    grid-template-areas: 'bio' 'model' 'current';
    gap: 1.75rem;
  }

  .text { grid-area: bio; }
  .art { grid-area: model; min-width: 0; align-self: center; }

  .location, .email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
  }

  .location { color: var(--muted); }

  .text svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h1 {
    margin-top: 0.85rem;
    font-size: clamp(3.55rem, 7.15vw, 6.7rem);
    font-weight: 550;
    line-height: 1.02;
    letter-spacing: -0.065em;
  }

  .role {
    margin-top: 0.4rem;
    color: var(--text-2);
    font-size: var(--step-3);
    font-weight: 450;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .intro {
    max-width: 40ch;
    margin-top: 1.35rem;
    color: var(--text-2);
    font-size: clamp(1.0625rem, 0.95rem + 0.34vw, var(--step-1));
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1.6rem;
  }

  .email {
    min-height: 2.75rem;
    color: var(--text-2);
    font-weight: 500;
    text-decoration: none;
  }

  .email:hover, .current a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .current {
    grid-area: current;
    display: grid;
    gap: 0.2rem;
    justify-items: start;
    border-left: 2px solid var(--border-2);
    padding-left: 0.85rem;
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .current span { color: var(--muted); }
  .current a { color: var(--text-2); text-decoration-color: var(--border-2); }

  @media (min-width: 52rem) {
    .grid {
      grid-template-areas: '. model' 'bio model' 'current model' '. model';
      grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
      grid-template-rows: 1fr auto auto 1fr;
      gap: 0 clamp(2.25rem, 4vw, 4.25rem);
    }

    .current { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  }
</style>
