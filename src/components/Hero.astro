---
import { lines } from '../data/lines';
import { profile } from '../data/profile';
---

<section class="hero" id="top" aria-labelledby="name">
  <div class="wrap grid">
    <div class="text">
      <h1 id="name">{profile.name}</h1>
      <p class="hindi" lang="hi">{profile.nameHindi}</p>
      <div class="band" aria-hidden="true">
        {lines.map((line) => <span style={`--c: var(--${line.id})`}></span>)}
      </div>
      <p class="role">{profile.role}</p>
      <p class="intro">{profile.intro}</p>
      <p class="approach">{profile.approach}</p>
      <p class="now">
        {profile.current}<br />
        {profile.location}
      </p>
      <div class="actions">
        <a class="button primary" href={`mailto:${profile.email}`}>Email me</a>
        <a class="button" href={profile.linkedin}>LinkedIn</a>
        <a class="button" href={profile.github}>GitHub</a>
      </div>
    </div>
    <slot />
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 1.5rem + 6vw, 7rem);
  }

  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  h1 {
    font-size: var(--step-5);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .hindi {
    margin-top: 0.5rem;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.2;
    color: var(--muted);
  }

  .band {
    display: flex;
    gap: 5px;
    margin-block: 1.75rem 1.5rem;
  }

  .band span {
    width: 2.5rem;
    height: var(--line);
    border-radius: 99px;
    background: var(--c);
  }

  .role {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.2;
  }

  .intro {
    max-width: 36ch;
    margin-top: 0.75rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .approach {
    max-width: 46ch;
    margin-top: 1rem;
    color: var(--muted);
  }

  .now {
    margin-top: 1.5rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
