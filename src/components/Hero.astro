---
import { profile } from '../data/profile';
import SystemDiagram from './SystemDiagram.astro';
---

<section class="hero" id="top" aria-labelledby="name">
  <div class="wrap grid">
    <div class="text">
      <h1 id="name">{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p class="intro">{profile.intro}</p>
      <div class="actions">
        <a class="button primary" href={`mailto:${profile.email}`}>Email me</a>
        <a class="button" href={profile.linkedin}>LinkedIn</a>
        <a class="button" href={profile.github}>GitHub</a>
      </div>
      <dl class="facts">
        <div>
          <dt>Now</dt>
          <dd>{profile.current}</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{profile.location}</dd>
        </div>
      </dl>
    </div>
    <SystemDiagram />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: -4rem;
    padding-block: calc(4rem + clamp(3.5rem, 1.5rem + 6vw, 7rem)) clamp(2rem, 1rem + 3vw, 4rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-position: center top;
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 75% 65% at 50% 0%, #000 35%, transparent 100%);
  }

  .hero::after {
    content: '';
    position: absolute;
    top: -30%;
    right: -15%;
    z-index: -1;
    width: 75%;
    height: 110%;
    background: radial-gradient(closest-side, rgb(110 161 255 / 0.12), transparent);
    pointer-events: none;
  }

  .grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    }
  }

  h1 {
    font-size: clamp(3rem, 1.6rem + 4.6vw, 4.75rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .role {
    margin-top: 0.85rem;
    color: var(--text-2);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .intro {
    max-width: 38ch;
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .facts {
    display: grid;
    gap: 0.6rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }

  .facts div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
  }

  dt {
    color: var(--muted);
  }

  dd {
    color: var(--text-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .text > * {
      animation: rise 0.7s var(--ease) var(--rise, 0s) both;
    }

    .role {
      --rise: 0.08s;
    }

    .intro {
      --rise: 0.16s;
    }

    .actions {
      --rise: 0.24s;
    }

    .facts {
      --rise: 0.32s;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>
