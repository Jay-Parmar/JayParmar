---
import { heroLabels, practice } from '../data/profile';

const samples = Array.from({ length: 21 }, (_, i) => i / 20);

function surface(across: boolean) {
  const point = (u: number, v: number) => {
    const bend = across
      ? Math.cos(Math.PI * u) * Math.sin(Math.PI * v)
      : Math.sin(Math.PI * u) * Math.cos(Math.PI * v);
    const x = 10 + 210 * u + 138 * v;
    const y = 94 + 78 * u - 58 * v - 52 * bend;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  };
  const edge = [
    ...samples.map((u) => point(u, 0)), ...samples.map((v) => point(1, v)),
    ...samples.map((u) => point(1 - u, 1)), ...samples.map((v) => point(0, 1 - v)),
  ];
  const lines = samples.flatMap((t) => [
    samples.map((u) => point(u, t)),
    samples.map((v) => point(t, v)),
  ]);
  return {
    skin: `M${edge.join(' ')}Z`,
    mesh: lines.map((line) => `M${line.join(' ')}`).join(' '),
    selvedge: `M${samples.map((u) => point(u, 0)).join(' ')}`,
  };
}

const rest = surface(false);
const turned = surface(true);
---

<div class="portrait" role="group" aria-label={heroLabels.practice}>
  <svg viewBox="0 0 550 328" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <g id="woven-sheet">
        {(['skin', 'mesh', 'selvedge'] as const).map((part) => (
          <path class={part} d={rest[part]} style={`--turned: path('${turned[part]}')`} />
        ))}
      </g>
    </defs>
    {[2, 1, 0].map((index) => (
      <g transform={`translate(0 ${index * 66})`}>
        <use href="#woven-sheet" class={`sheet level-${index}`} />
        <path class="leader" d="M358 114l15-9h13" />
        <circle class="pin" cx="358" cy="114" r="2.2" />
      </g>
    ))}
  </svg>
  {practice.map((layer, index) => (
    <a href={`#${layer.target}`} style={`top: ${(105 + 66 * index) / 328 * 100}%`}>
      <strong>{layer.name}</strong>
      <span>{layer.tools}</span>
    </a>
  ))}
</div>

<style>
  .portrait {
    position: relative;
    isolation: isolate;
    align-self: center;
  }

  .portrait::before {
    content: '';
    position: absolute;
    inset: 0 22% 0 -10%;
    z-index: -1;
    background: radial-gradient(ellipse, var(--glow), transparent 68%);
  }

  svg { width: 100%; height: auto; overflow: visible; }
  .skin { fill: var(--bg-raised); stroke: currentColor; stroke-width: 1; }
  .mesh { fill: none; stroke: currentColor; stroke-width: 0.68; opacity: 0.75; }
  .selvedge { fill: none; stroke: currentColor; stroke-width: 1.4; }
  .level-0 { color: var(--accent); }
  .level-1 { color: color-mix(in srgb, var(--accent) 50%, var(--muted)); }
  .level-2 { color: var(--muted); }
  .leader { fill: none; stroke: var(--muted); stroke-width: 0.8; }
  .pin { fill: var(--accent); }

  a {
    position: absolute;
    left: 71.5%;
    right: 0;
    display: grid;
    align-content: center;
    min-height: 2.75rem;
    transform: translateY(-50%);
    font-size: clamp(0.8rem, 1.2vw, 1.04rem);
    line-height: 1.25;
    text-decoration: none;
  }

  a:hover strong, a:focus-visible strong { color: var(--accent); }
  .portrait:has(a:nth-of-type(2):is(:hover, :focus-visible)) .level-1,
  .portrait:has(a:nth-of-type(3):is(:hover, :focus-visible)) .level-2 { color: var(--accent); }
  a span {
    margin-top: 0.25rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: clamp(0.72rem, 0.92vw, 0.84rem);
  }

  @media (max-width: 32rem) {
    svg { width: 88%; height: 16.5rem; }
    a { left: 63%; font-size: 0.85rem; }
    a span { font-size: 0.75rem; }
  }

  @media (max-width: 22rem) {
    svg { width: 76%; height: 18.5rem; }
    a { left: 54.5%; }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (d: path('M0 0L1 1')) {
      :global(.hero) {
        view-timeline-name: --stack-exit;
        view-timeline-inset: 0;
      }

      #woven-sheet path {
        animation: turn-weave auto linear both;
        animation-timeline: --stack-exit;
        animation-range: exit 0% exit 65%;
      }
    }
  }

  @keyframes turn-weave {
    to { d: var(--turned); }
  }
</style>
