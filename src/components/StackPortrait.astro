---
import { heroLabels, practice } from '../data/profile';
import { weavePaths } from '../lib/weave';

const rest = weavePaths(0);
---

<div class="portrait" role="group" aria-label={heroLabels.practice}>
  <svg viewBox="0 0 550 328" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <g id="woven-sheet">
        {(['skin', 'mesh', 'selvedge'] as const).map((part) => (
          <path class={part} d={rest[part]} />
        ))}
      </g>
    </defs>
    {[2, 1, 0].map((index) => (
      <g transform={`translate(0 ${index * 66})`}>
        <use href="#woven-sheet" class={`sheet level-${index}`} />
        <path class="leader" d="M358 114l15-9h13" />
        <circle class="pin" cx="358" cy="114" r="2.2" />
      </g>
    ))}
  </svg>
  {practice.map((layer, index) => (
    <a href={`#${layer.target}`} style={`top: ${(105 + 66 * index) / 328 * 100}%`}>
      <strong>{layer.name}</strong>
      <span>{layer.tools}</span>
    </a>
  ))}
  <button type="button" class="motion-control" data-weave-control data-resume={heroLabels.resumeWeave}
    aria-label={heroLabels.pauseWeave} title={heroLabels.pauseWeave} hidden>
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path class="pause" d="M5 3v10m6-10v10" />
      <path class="play" d="m5 3 7 5-7 5z" />
    </svg>
  </button>
</div>

<script>
  import { weavePaths } from '../lib/weave';

  const portrait = document.querySelector<HTMLElement>('.portrait')!;
  const hero = portrait.closest<HTMLElement>('.hero')!;
  const skin = portrait.querySelector('.skin')!;
  const mesh = portrait.querySelector('.mesh')!;
  const edge = portrait.querySelector('.selvedge')!;
  const button = portrait.querySelector<HTMLButtonElement>('[data-weave-control]')!;
  const pauseLabel = button.title;
  const motion = matchMedia('screen and (prefers-reduced-motion: no-preference)');
  let visible = false;
  let paused = false;
  let frame = 0;
  let previous = 0;
  let phase = 0;
  let turn = 0;
  let targetTurn = 0;

  function draw(angle: number) {
    const paths = weavePaths(angle);
    skin.setAttribute('d', paths.skin);
    mesh.setAttribute('d', paths.mesh);
    edge.setAttribute('d', paths.selvedge);
  }

  function readScroll() {
    if (!visible || !motion.matches) return;
    const rect = hero.getBoundingClientRect();
    const exit = Math.max(0, Math.min(1, -rect.top / (rect.height * 0.65)));
    targetTurn = exit * Math.PI / 2;
  }

  function tick(now: number) {
    const elapsed = previous ? Math.min(now - previous, 100) : 0;
    previous = now;
    phase = (phase + elapsed * 2 * Math.PI / 9000) % (2 * Math.PI);
    turn += (targetTurn - turn) * (1 - Math.exp(-elapsed / 100));
    draw(phase + turn);
    frame = requestAnimationFrame(tick);
  }

  function sync() {
    cancelAnimationFrame(frame);
    previous = 0;
    button.hidden = !motion.matches;
    if (!motion.matches) {
      phase = 0;
      turn = 0;
      draw(0);
    } else if (visible && !paused && !document.hidden) {
      readScroll();
      frame = requestAnimationFrame(tick);
    }
  }

  button.addEventListener('click', () => {
    paused = !paused;
    button.toggleAttribute('data-paused', paused);
    button.title = paused ? button.dataset.resume! : pauseLabel;
    button.setAttribute('aria-label', button.title);
    sync();
  });
  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    sync();
  }).observe(portrait);
  motion.addEventListener('change', sync);
  document.addEventListener('visibilitychange', sync);
  addEventListener('scroll', readScroll, { passive: true });
  addEventListener('resize', readScroll);
</script>

<style>
  .portrait {
    position: relative;
    isolation: isolate;
    align-self: center;
  }

  .portrait::before {
    content: '';
    position: absolute;
    inset: 0 22% 0 -10%;
    z-index: -1;
    background: radial-gradient(ellipse, var(--glow), transparent 68%);
  }

  .portrait > svg { width: 100%; height: auto; overflow: visible; }
  .skin { fill: var(--bg-raised); stroke: currentColor; stroke-width: 1; }
  .mesh { fill: none; stroke: currentColor; stroke-width: 0.68; opacity: 0.75; }
  .selvedge { fill: none; stroke: currentColor; stroke-width: 1.4; }
  .level-0 { color: var(--accent); }
  .level-1 { color: color-mix(in srgb, var(--accent) 50%, var(--muted)); }
  .level-2 { color: var(--muted); }
  .leader { fill: none; stroke: var(--muted); stroke-width: 0.8; }
  .pin { fill: var(--accent); }

  a {
    position: absolute;
    left: 71.5%;
    right: 0;
    display: grid;
    align-content: center;
    min-height: 2.75rem;
    transform: translateY(-50%);
    font-size: clamp(0.8rem, 1.2vw, 1.04rem);
    line-height: 1.25;
    text-decoration: none;
  }

  a:hover strong, a:focus-visible strong { color: var(--accent); }
  .portrait:has(a:nth-of-type(2):is(:hover, :focus-visible)) .level-1,
  .portrait:has(a:nth-of-type(3):is(:hover, :focus-visible)) .level-2 { color: var(--accent); }
  a span {
    margin-top: 0.25rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: clamp(0.72rem, 0.92vw, 0.84rem);
  }

  @media (max-width: 32rem) {
    .portrait > svg { width: 88%; height: 16.5rem; }
    a { left: 63%; font-size: 0.85rem; }
    a span { font-size: 0.75rem; }
  }

  @media (max-width: 22rem) {
    .portrait > svg { width: 76%; height: 18.5rem; }
    a { left: 54.5%; }
  }

  .motion-control {
    position: absolute;
    right: 0;
    bottom: -0.25rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border-2);
    border-radius: 50%;
    background: var(--bg-raised);
    color: var(--muted);
    cursor: pointer;
  }

  .motion-control:hover { color: var(--text); }
  .motion-control svg { width: 0.875rem; height: 0.875rem; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .motion-control[hidden], .play, [data-paused] .pause { display: none; }
  [data-paused] .play { display: inline; }
</style>
