---
import { lines, type LineId } from '../data/lines';

interface Props {
  ids: LineId[];
}

const { ids } = Astro.props;
const names = new Map(lines.map((line) => [line.id, line.name]));
---

<ul class="marks" role="list" aria-label="Skill lines">
  {
    ids.map((id) => (
      <li>
        <span class="badge" style={`--c: var(--${id})`}>
          {names.get(id)}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
