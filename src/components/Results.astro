---
import { results } from '../data/results';
---

<section class="section" id="results" aria-labelledby="results-title">
  <div class="wrap">
    <h2 class="title" id="results-title">Impact</h2>
    <ul class="panel cells" role="list">
      {
        results.map((result) => {
          const top = Math.max(result.before, result.after);
          const moves = result.kind === 'change';
          return (
            <li
              class="result"
              data-start={moves ? result.before : undefined}
              data-end={moves ? result.after : undefined}
              data-from={moves ? result.before / top : undefined}
            >
              <h3>{result.label}</h3>
              <div class="stat">
                <span class="number" aria-hidden="true">
                  {result.afterText
                    .split(/(\d+\S*)/)
                    .map((part, i) => (i % 2 ? <span class="figure">{part}</span> : part && <span class="unit">{part}</span>))}
                </span>
                {result.delta && <span class="delta">{result.delta}</span>}
              </div>
              <dl class="bars">
                <div class="bar" style={`--w: ${result.before / top}`}>
                  <dt>{result.beforeName}</dt>
                  <dd>{result.beforeText}</dd>
                </div>
                <div class="bar after" style={`--w: ${result.after / top}`}>
                  <dt>{result.afterName}</dt>
                  <dd>
                    <span class="value" aria-hidden="true">{result.afterText}</span>
                    <span class="visually-hidden">{result.afterText}</span>
                  </dd>
                </div>
              </dl>
              <p class="context">{result.context}</p>
              <a class="work" href={`#work-${result.id}`}>{result.workLabel}</a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  const cells = [...document.querySelectorAll<HTMLElement>('.result[data-start]')];
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');

  if (cells.length && motion.matches) {
    const ease = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
    const parts = (cell: HTMLElement) => [...cell.querySelectorAll<HTMLElement>('.stat, .bars')];
    const after = (cell: HTMLElement) => cell.querySelector<HTMLElement>('.after')!;
    const counts = (cell: HTMLElement) => [...cell.querySelectorAll<HTMLElement>('.figure, .after .value')];
    const widths = new Map(cells.map((cell) => [cell, after(cell).style.getPropertyValue('--w')]));
    const finals = new Map(cells.flatMap(counts).map((count) => [count, count.textContent ?? '']));
    const started = new Set<HTMLElement>();
    const done = new Set<HTMLElement>();

    const show = (cell: HTMLElement, value: string) => {
      for (const count of counts(cell)) count.textContent = finals.get(count)!.replace(/\d+/, value);
    };

    const finish = (cell: HTMLElement) => {
      done.add(cell);
      for (const part of parts(cell)) observer.unobserve(part);
      cell.classList.remove('is-pending', 'is-moving');
      after(cell).style.setProperty('--w', widths.get(cell)!);
      for (const count of counts(cell)) count.textContent = finals.get(count)!;
    };

    const run = (cell: HTMLElement) => {
      const start = Number(cell.dataset.start);
      const end = Number(cell.dataset.end);
      const began = performance.now();

      void cell.offsetWidth;
      cell.classList.add('is-moving');
      after(cell).style.setProperty('--w', widths.get(cell)!);

      const tick = (now: number) => {
        if (done.has(cell)) return;
        const t = Math.min(1, (now - began) / 1400);
        if (t === 1) return finish(cell);
        show(cell, String(Math.round(start + (end - start) * ease(t))));
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const cell = entry.target.closest<HTMLElement>('.result')!;
          if (!entry.isIntersecting || started.has(cell) || done.has(cell)) continue;
          started.add(cell);
          for (const part of parts(cell)) observer.unobserve(part);
          run(cell);
        }
      },
      { threshold: 1, rootMargin: '0px 0px -15% 0px' },
    );

    for (const cell of cells) {
      cell.classList.add('is-pending');
      after(cell).style.setProperty('--w', cell.dataset.from ?? '1');
      show(cell, cell.dataset.start ?? '');
      for (const part of parts(cell)) observer.observe(part);
    }

    const finishAll = () => {
      observer.disconnect();
      cells.forEach(finish);
    };

    motion.addEventListener('change', finishAll, { once: true });
    addEventListener('beforeprint', finishAll);
  }
</script>

<style>
  .section {
    --spacing: clamp(2.5rem, 3.5vw, 3.5rem);
    padding-top: var(--spacing);
    scroll-margin-top: calc(1rem - var(--spacing));
  }

  .cells {
    display: grid;
    gap: 1px;
    margin-top: 1.5rem;
    overflow: hidden;
    background: var(--border);
  }

  @media (min-width: 44rem) {
    .cells {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 70rem) {
    .cells {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .result {
    display: flex;
    flex-direction: column;
    padding: var(--inset);
    background: var(--surface);
  }

  h3 {
    color: var(--text-2);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .stat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    margin-top: 0.75rem;
  }

  .number {
    color: var(--text);
    font-size: clamp(2.75rem, 2.4rem + 1vw, 3rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .unit {
    color: var(--text-2);
    font-size: 0.5em;
    font-weight: 500;
    letter-spacing: 0;
  }

  .delta {
    padding: 0.2rem 0.65rem;
    border: 1px solid rgb(110 161 255 / 0.25);
    border-radius: 999px;
    background: rgb(110 161 255 / 0.08);
    color: var(--accent);
    font-size: var(--step--2);
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
  }

  .bars {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8125rem;
    color: var(--muted);
    font-size: var(--step--2);
    line-height: 1.4;
  }

  .bar::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: calc(100% * var(--w));
    min-width: 4px;
    height: 6px;
    border-radius: 0 3px 3px 0;
    background: var(--muted);
    opacity: 0.55;
  }

  .after::after {
    background: var(--accent);
    opacity: 1;
  }

  dd {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .context {
    max-width: 52ch;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .work {
    align-self: start;
    margin-top: auto;
    padding-top: 0.85rem;
    color: var(--text-2);
    font-size: var(--step--1);
  }

  @media (min-width: 44rem) {
    @supports (grid-template-rows: subgrid) {
      .result {
        display: grid;
        grid-template-rows: subgrid;
        grid-row: span 5;
      }
    }
  }

  @media (min-width: 70rem) {
    .stat {
      flex-direction: column;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-moving .after::after {
      transition: width 1.4s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .delta {
      transition:
        opacity 0.5s var(--ease),
        transform 0.5s var(--ease);
    }

    .is-pending .delta {
      opacity: 0;
      transform: translateX(-0.375rem);
    }
  }

  @media (forced-colors: active) {
    .result {
      outline: 1px solid CanvasText;
    }

    .bar::after {
      background: CanvasText;
    }

    .after::after {
      background: Highlight;
    }
  }
</style>
