---
import { languages, lines } from '../data/lines';
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <h2 class="title" id="skills-title">Skills</h2>
    <p class="lead">Each colour on this page is one of these lines.</p>
    <dl class="legend">
      <div class="row">
        <dt>Languages</dt>
        <dd>{languages.join(', ')}</dd>
      </div>
      {
        lines.map((line) => (
          <div class="row line" style={`--c: var(--${line.id})`}>
            <dt>{line.name}</dt>
            <dd>{line.skills.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  section {
    padding-bottom: var(--section);
  }

  .legend {
    margin: 3rem 0 0;
  }

  .row {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.1rem;
    border-top: 2px solid var(--track);
  }

  .row:last-child {
    border-bottom: 2px solid var(--track);
  }

  @media (min-width: 46rem) {
    .row {
      grid-template-columns: 16rem 1fr;
      align-items: baseline;
    }
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
  }

  .line dt::before {
    content: '';
    flex: none;
    width: 2.5rem;
    height: var(--line);
    border-radius: 99px;
    background: var(--c);
  }

  dd {
    margin: 0;
    max-width: var(--measure);
  }
</style>
