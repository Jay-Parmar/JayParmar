---
import SiteNav from '../components/SiteNav.astro';
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';
import { link } from '../lib/url';
---

<Base title={`Page not found, ${profile.name}`} description="This page doesn't exist, or it has moved.">
  <SiteNav />

  <main id="main" class="lost">
    <div class="wrap">
      <p class="code" aria-hidden="true">404</p>
      <h1>Page not found</h1>
      <p class="note">The page you were looking for doesn't exist, or it has moved.</p>
      <p class="actions">
        <a class="button primary" href={link()}>Back to the home page</a>
        <a class="button" href={link('#projects')}>See the projects</a>
      </p>
    </div>
  </main>
</Base>

<style>
  .lost {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    margin-top: -4rem;
    padding-block: calc(4rem + clamp(3rem, 2rem + 4vw, 5rem)) clamp(4rem, 3rem + 4vw, 6rem);
    overflow: hidden;
    text-align: center;
  }

  .lost::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-position: center top;
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 35%, #000 15%, transparent 100%);
  }

  .lost::after {
    content: '';
    position: absolute;
    top: -25%;
    left: 50%;
    z-index: -1;
    width: min(60rem, 100%);
    height: 85%;
    translate: -50% 0;
    background: radial-gradient(closest-side, rgb(110 161 255 / 0.12), transparent);
    pointer-events: none;
  }

  .code {
    font-size: clamp(6.5rem, 3rem + 15vw, 12rem);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.06em;
    background: linear-gradient(to bottom, rgb(237 240 245 / 0.22), rgb(237 240 245 / 0.03));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  h1 {
    margin-top: 1.75rem;
    font-size: var(--step-4);
    letter-spacing: -0.03em;
  }

  .note {
    max-width: 40ch;
    margin: 1rem auto 0;
    color: var(--muted);
    font-size: var(--step-1);
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (max-width: 29.99rem) {
    .actions {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .wrap > * {
      animation: enter 0.7s var(--ease) var(--delay, 0s) both;
    }

    h1 {
      --delay: 0.08s;
    }

    .note {
      --delay: 0.16s;
    }

    .actions {
      --delay: 0.24s;
    }
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>
