---
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';
import { link } from '../lib/url';
---

<Base title={`Page not found, ${profile.name}`} description="This page isn't on the map.">
  <header class="bar">
    <div class="wrap inner">
      <a class="home" href={link()}>{profile.name}</a>
    </div>
  </header>

  <main id="main" class="wrap lost">
    <svg class="closed" viewBox="0 0 360 60" aria-hidden="true">
      <path class="track" d="M10 30H230" />
      <path class="gone" d="M250 30H350" />
      <circle class="stop" cx="240" cy="30" r="13" />
      <path class="cross" d="M231 39l18-18" />
    </svg>
    <h1>This station isn't on the map</h1>
    <p>The page you were looking for doesn't exist, or it has moved.</p>
    <p class="actions">
      <a class="button primary" href={link()}>Back to the map</a>
      <a class="button" href={link('#projects')}>See the projects</a>
    </p>
  </main>
</Base>

<style>
  .bar {
    border-bottom: 1px solid var(--track);
  }

  .inner {
    display: flex;
    align-items: center;
    min-height: 4rem;
  }

  .home {
    font-weight: 800;
    text-decoration: none;
  }

  .lost {
    max-width: 44rem;
    padding-block: clamp(4rem, 2rem + 8vw, 9rem);
  }

  .closed {
    width: min(100%, 22rem);
    margin-bottom: 2.5rem;
  }

  .track,
  .gone,
  .cross {
    fill: none;
    stroke-linecap: round;
  }

  .track {
    stroke: var(--backend);
    stroke-width: 7;
  }

  .gone {
    stroke: var(--track);
    stroke-width: 7;
    stroke-dasharray: 2 14;
  }

  .stop {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 4;
  }

  .cross {
    stroke: var(--ink);
    stroke-width: 4;
  }

  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.015em;
  }

  p {
    max-width: 40ch;
    margin-top: 1rem;
    font-size: var(--step-1);
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
