---
import LineMark from '../../components/LineMark.astro';
import { profile } from '../../data/profile';
import { projects, type Project } from '../../data/projects';
import Base from '../../layouts/Base.astro';
import { link } from '../../lib/url';

export function getStaticPaths() {
  return projects
    .filter((project) => project.page)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { what, how } = project.page!;
---

<Base title={`${project.name}, a project by ${profile.name}`} description={project.tagline}>
  <header class="bar">
    <div class="wrap inner">
      <a class="home" href={link()}>{profile.name}</a>
      <a href={link('#projects')}>All projects</a>
    </div>
  </header>

  <main id="main" class="wrap page">
    <LineMark ids={project.lines} />
    <p class="year">{project.year}</p>
    <h1 style={`view-transition-name: project-${project.slug}`}>{project.name}</h1>
    <p class="tagline">{project.tagline}</p>
    <ul class="facts" role="list">
      {project.facts.map((fact) => <li>{fact}</li>)}
    </ul>

    <section aria-labelledby="what">
      <h2 id="what">What it does</h2>
      <ul role="list">
        {what.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section aria-labelledby="how">
      <h2 id="how">How it's built</h2>
      <ul role="list">
        {how.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <p class="stack">Built with {project.stack.join(', ')}.</p>
    <p class="actions">
      <a class="button primary" href={project.code}>Code on GitHub</a>
      <a class="button" href={link('#projects')}>All projects</a>
    </p>
  </main>
</Base>

<style>
  .bar {
    border-bottom: 1px solid var(--track);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    font-weight: 500;
  }

  .home {
    font-weight: 800;
    text-decoration: none;
  }

  .page {
    max-width: 52rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .year {
    margin-top: 1.25rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
  }

  h1 {
    width: fit-content;
    font-size: var(--step-5);
    letter-spacing: -0.02em;
  }

  .tagline {
    max-width: 44ch;
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1.5rem;
    font-weight: 700;
  }

  .facts li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .facts li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    transform: translateY(-0.1em);
  }

  section {
    margin-top: 3rem;
  }

  h2 {
    font-size: var(--step-3);
  }

  section ul {
    display: grid;
    gap: 0.85rem;
    max-width: var(--measure);
    margin-top: 1.25rem;
  }

  section li {
    position: relative;
    padding-left: 1.25rem;
  }

  section li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .stack {
    margin-top: 3rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
