---
import ProjectMeta from '../../components/ProjectMeta.astro';
import SiteNav from '../../components/SiteNav.astro';
import { profile } from '../../data/profile';
import { contentsLabel, projectSections, projects, type Project } from '../../data/projects';
import Base from '../../layouts/Base.astro';
import { splitFact } from '../../lib/facts';
import { link } from '../../lib/url';

export function getStaticPaths() {
  return projects
    .filter((project) => project.page)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { steps, how } = project.page!;
const withPages = projects.filter((other) => other.page);
const next = withPages[(withPages.indexOf(project) + 1) % withPages.length];

const facts = [...project.facts].sort((a, b) => Number(!splitFact(a)[0]) - Number(!splitFact(b)[0]));
---

<Base title={`${project.name}, a project by ${profile.name}`} description={project.tagline}>
  <SiteNav current="projects" />

  <main id="main" class="wrap page">
    <a class="back" href={link(`#project-${project.slug}`)}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5"></path></svg>
      All projects
    </a>
    <ProjectMeta project={project} />
    <h1 style={`view-transition-name: project-${project.slug}`}>{project.name}</h1>
    <p class="tagline">{project.tagline}</p>
    <p class="lead-actions">
      <a class="button primary" href={project.code}>Code on GitHub</a>
    </p>

    <ul class="stats panel" role="list">
      {
        facts.map((fact) => {
          const [num, label] = splitFact(fact);
          return (
            <li>
              {num && <span class="num">{num}</span>} <span class="label">{label}</span>
            </li>
          );
        })
      }
    </ul>

    <div class="reading">
      <nav class="contents" aria-label={contentsLabel}>
        <p>{contentsLabel}</p>
        <ul role="list">
          {Object.entries(projectSections).map(([id, name]) => <li><a href={`#${id}`}>{name}</a></li>)}
        </ul>
      </nav>
      <div>
        <section class="part" aria-labelledby="what">
          <h2 id="what" tabindex="-1">{projectSections.what}</h2>
          <ol class="steps" role="list">
            {steps.map((step) => (
              <li id={`step-${step.id}`} tabindex="-1">
                <h3>{step.name}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </section>

        <section class="part" aria-labelledby="how">
          <h2 id="how" tabindex="-1">{projectSections.how}</h2>
          <ul class="points" role="list">
            {how.map((point) => <li>{point}</li>)}
          </ul>
        </section>

        <section class="part" aria-labelledby="stack">
          <h2 id="stack" tabindex="-1">{projectSections.stack}</h2>
          <ul class="stack" role="list">
            {project.stack.map((tool) => <li class="chip">{tool}</li>)}
          </ul>
        </section>
      </div>
    </div>

    <p class="actions">
      <a class="button" href={project.code}>Code on GitHub</a>
      <a class="button" href={link(`#project-${project.slug}`)}>All projects</a>
    </p>

    <a class="next panel" href={link(`projects/${next.slug}/`)}>
      <span class="label">Next project</span>
      <span class="name">{next.name}</span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5L10.5 8 6 12.5"></path></svg>
    </a>
  </main>
</Base>

<style>
  .page {
    position: relative;
    isolation: isolate;
    max-width: 64rem;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(5rem, 3.5rem + 6vw, 9rem);
  }

  .page::before {
    content: '';
    position: absolute;
    inset: -4rem 0 auto;
    z-index: -1;
    height: 34rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 9%, transparent), transparent);
    pointer-events: none;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }

  .back:hover {
    color: var(--text);
  }

  .back svg,
  .next svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h1 {
    width: fit-content;
    margin-top: 1.25rem;
    font-size: var(--step-5);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .tagline {
    max-width: 36ch;
    margin-top: 1.5rem;
    color: var(--text-2);
    font-size: var(--step-2);
    line-height: 1.45;
  }

  .lead-actions {
    margin-top: 1.75rem;
  }

  .stats {
    display: grid;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    overflow: hidden;
  }

  .stats li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem var(--inset);
  }

  .stats li + li {
    border-top: 1px solid var(--border);
  }

  .num {
    color: var(--text);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .label {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .label:only-child {
    color: var(--text);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    text-wrap: balance;
  }

  @media (min-width: 40rem) {
    .stats {
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
    }

    .stats li {
      flex-direction: column;
      align-items: start;
      justify-content: center;
      padding-block: 1.5rem;
    }

    .stats li + li {
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }

  .reading {
    display: grid;
    align-items: start;
    gap: 2.25rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .contents {
    padding-block: 0.75rem;
    border-block: 1px solid var(--border);
    font-size: var(--step--1);
  }

  .contents p {
    color: var(--muted);
  }

  .contents ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .contents a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .part + .part {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 48rem) {
    .reading {
      grid-template-columns: minmax(9rem, 0.3fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 6vw, 6rem);
    }

    .contents {
      position: sticky;
      top: 6rem;
      padding-block: 0;
      padding-left: 1rem;
      border: 0;
      border-left: 1px solid var(--border-2);
    }

    .contents ul { display: grid; margin-top: 0.4rem; }
  }

  h2 {
    margin-bottom: 1.35rem;
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  h3 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  .steps li {
    position: relative;
    padding-left: 1.4rem;
    max-width: var(--measure);
  }

  .steps li:not(:last-child) {
    padding-bottom: 1.65rem;
  }

  .steps li::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: var(--bg);
  }

  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(0.275rem - 0.5px);
    top: 1rem;
    bottom: -0.45rem;
    width: 1px;
    background: var(--border-2);
  }

  .steps li:target::before {
    border-color: var(--accent);
    background: var(--accent);
  }

  .steps p {
    margin-top: 0.45rem;
  }

  .points li {
    max-width: var(--measure);
    padding-bottom: 1rem;
  }

  .points li + li {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .next {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.35rem 1rem;
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    color: var(--text);
    text-decoration: none;
  }

  .next:hover {
    border-color: var(--border-2);
  }

  .next .label {
    grid-column: 1;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .next .name {
    grid-column: 1;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .next svg {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
  }

  .next:hover svg {
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .back { transition: color 0.2s; }
    .next { transition: border-color 0.25s; }
    .next svg {
      transition:
        color 0.2s,
        transform 0.2s var(--ease);
    }
    .next:hover svg { transform: translateX(3px); }
  }
</style>
