---
import SiteNav from '../../components/SiteNav.astro';
import { profile } from '../../data/profile';
import { projects, type Project } from '../../data/projects';
import Base from '../../layouts/Base.astro';
import { link } from '../../lib/url';

export function getStaticPaths() {
  return projects
    .filter((project) => project.page)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { what, how } = project.page!;
const withPages = projects.filter((other) => other.page);
const next = withPages[(withPages.indexOf(project) + 1) % withPages.length];

/** The number a fact starts with, if any, and the rest of it. */
const split = (fact: string) => fact.match(/^(\d[\d,.]*\+?) (.+)$/)?.slice(1) ?? [undefined, fact];
const facts = [...project.facts].sort((a, b) => Number(!split(a)[0]) - Number(!split(b)[0]));
---

<Base title={`${project.name}, a project by ${profile.name}`} description={project.tagline}>
  <SiteNav current="projects" />

  <main id="main" class="wrap page">
    <a class="back" href={link(`#project-${project.slug}`)}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5"></path></svg>
      All projects
    </a>
    <p class="meta">
      <span>{project.year}</span>
      {project.code && <span class="open">Open source</span>}
    </p>
    <h1 style={`view-transition-name: project-${project.slug}`}>{project.name}</h1>
    <p class="tagline">{project.tagline}</p>

    <ul class="stats panel" role="list">
      {
        facts.map((fact) => {
          const [num, label] = split(fact);
          return (
            <li>
              {num && <span class="num">{num}</span>} <span class="label">{label}</span>
            </li>
          );
        })
      }
    </ul>

    <section class="part" aria-labelledby="what">
      <h2 id="what">What it does</h2>
      <ul class="points" role="list">
        {what.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section class="part" aria-labelledby="how">
      <h2 id="how">How it's built</h2>
      <ul class="points" role="list">
        {how.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section class="part" aria-labelledby="stack">
      <h2 id="stack">Built with</h2>
      <ul class="stack" role="list">
        {project.stack.map((tool) => <li class="chip">{tool}</li>)}
      </ul>
    </section>

    <p class="actions">
      <a class="button primary" href={project.code}>Code on GitHub</a>
      <a class="button" href={link(`#project-${project.slug}`)}>All projects</a>
    </p>

    <a class="next panel" href={link(`projects/${next.slug}/`)}>
      <span class="label">Next project</span>
      <span class="name">{next.name}</span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5L10.5 8 6 12.5"></path></svg>
    </a>
  </main>
</Base>

<style>
  .page {
    position: relative;
    isolation: isolate;
    max-width: 52rem;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(5rem, 3.5rem + 6vw, 9rem);
  }

  .page::before {
    content: '';
    position: absolute;
    inset: -4rem 0 auto;
    z-index: -1;
    height: 34rem;
    background: radial-gradient(closest-side, rgb(110 161 255 / 0.09), transparent);
    pointer-events: none;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }

  .back:hover {
    color: var(--text);
  }

  .back svg,
  .next svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem 0.2rem 0.5rem;
    border: 1px solid var(--border-2);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--step--2);
    font-weight: 500;
    line-height: 1.3;
  }

  .open::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgb(110 161 255 / 0.16);
  }

  h1 {
    width: fit-content;
    margin-top: 1.25rem;
    font-size: var(--step-5);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .tagline {
    max-width: 36ch;
    margin-top: 1.5rem;
    color: var(--text-2);
    font-size: var(--step-2);
    line-height: 1.45;
  }

  .stats {
    display: grid;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    overflow: hidden;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
  }

  .stats li + li {
    border-top: 1px solid var(--border);
  }

  .num {
    color: var(--text);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .label {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .label:only-child {
    color: var(--text);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    text-wrap: balance;
  }

  @media (min-width: 40rem) {
    .stats {
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
    }

    .stats li {
      padding: 1.5rem 1.75rem;
    }

    .stats li + li {
      border-top: 0;
      border-left: 1px solid var(--border);
    }
  }

  .part {
    display: grid;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  @media (min-width: 48rem) {
    .part {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  h2 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  .points li {
    max-width: var(--measure);
    padding-bottom: 1rem;
  }

  .points li + li {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .next {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.35rem 1rem;
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.25s;
  }

  .next:hover {
    border-color: var(--border-2);
  }

  .next .label {
    grid-column: 1;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .next .name {
    grid-column: 1;
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .next svg {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
    transition:
      color 0.2s,
      transform 0.2s var(--ease);
  }

  .next:hover svg {
    color: var(--text);
    transform: translateX(3px);
  }
</style>
