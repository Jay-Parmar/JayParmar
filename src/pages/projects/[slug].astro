---
import SiteNav from '../../components/SiteNav.astro';
import { profile } from '../../data/profile';
import { projects, type Project } from '../../data/projects';
import Base from '../../layouts/Base.astro';
import { link } from '../../lib/url';

export function getStaticPaths() {
  return projects
    .filter((project) => project.page)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { what, how } = project.page!;
---

<Base title={`${project.name}, a project by ${profile.name}`} description={project.tagline}>
  <SiteNav />

  <main id="main" class="wrap page">
    <p class="meta">
      <span>{project.year}</span>
      {project.code && <span class="open">Open source</span>}
    </p>
    <h1 style={`view-transition-name: project-${project.slug}`}>{project.name}</h1>
    <p class="tagline">{project.tagline}</p>
    <ul class="facts" role="list">
      {project.facts.map((fact) => <li>{fact}</li>)}
    </ul>

    <section aria-labelledby="what">
      <h2 id="what">What it does</h2>
      <ul role="list">
        {what.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section aria-labelledby="how">
      <h2 id="how">How it's built</h2>
      <ul role="list">
        {how.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section aria-labelledby="stack">
      <h2 id="stack">Built with</h2>
      <ul class="stack" role="list">
        {project.stack.map((tool) => <li class="chip">{tool}</li>)}
      </ul>
    </section>
    <p class="actions">
      <a class="button primary" href={project.code}>Code on GitHub</a>
      <a class="button" href={link('#projects')}>All projects</a>
    </p>
  </main>
</Base>

<style>
  .page {
    max-width: 52rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem 0.2rem 0.5rem;
    border: 1px solid var(--border-2);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--step--2);
    font-weight: 500;
    line-height: 1.3;
  }

  .open::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgb(110 161 255 / 0.16);
  }

  h1 {
    width: fit-content;
    font-size: var(--step-5);
    letter-spacing: -0.02em;
  }

  .tagline {
    max-width: 44ch;
    margin-top: 1rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1.5rem;
    font-weight: 700;
  }

  .facts li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .facts li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    transform: translateY(-0.1em);
  }

  section {
    margin-top: 3rem;
  }

  h2 {
    font-size: var(--step-3);
  }

  section ul:not(.stack) {
    display: grid;
    gap: 0.85rem;
    max-width: var(--measure);
    margin-top: 1.25rem;
  }

  section li:not(.chip) {
    position: relative;
    padding-left: 1.25rem;
  }

  section li:not(.chip)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 3rem;
  }
</style>
